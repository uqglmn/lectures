		if (exactValues.some((value) => value === null)) {
			summary.innerHTML = `<strong>Exact input not accepted.</strong><br>Use a valid decimal or scientific-notation value with at most ${this.maxExactDigits} significant digits, with the written exponent and decimal scale between −${this.maxExactScale} and ${this.maxExactScale}. Exact scalar, root, multiplicity, and eigendirection claims are suppressed until all four entries are valid.`;
			svg.innerHTML = "";
			svg.setAttribute("aria-label", "An entry is blank, invalid, or outside the exact arithmetic limit, so no eigenvalue classification or drawing is shown.");
			return;
		}
		const [ea, eb, ec, ed] = exactValues as Rational[];
		const exactTrace = this.add(ea, ed), exactDet = this.subtract(this.multiply(ea, ed), this.multiply(eb, ec));
		const exactDisc = this.subtract(this.multiply(exactTrace, exactTrace), this.scale(exactDet, 4n));
		const scalar = eb.num === 0n && ec.num === 0n && this.subtract(ea, ed).num === 0n;
		const repeated = exactDisc.num === 0n, realRoots = exactDisc.num >= 0n;
		const a = this.get("a"), b = this.get("b"), c = this.get("c"), d = this.get("d"), trace = this.toNumber(exactTrace), det = this.toNumber(exactDet), disc = this.toNumber(exactDisc);
		const cx = 220, cy = 170, base = 58, outputScale = 58 / Math.max(1, Math.hypot(a, c), Math.hypot(b, d));
		const point = (x: number, y: number, s = base) => ({
			x: cx + x * s,
			y: cy - y * s
		}), line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70") + `<circle cx="${cx}" cy="${cy}" r="${base}" fill="none" stroke="#147d79" stroke-width="2" stroke-dasharray="5 4"/>`;
		const transformed = [];
		for (let i = 0; i <= 80; i++) {
			const angle = 2 * Math.PI * i / 80, x = Math.cos(angle), y = Math.sin(angle);
			transformed.push(point(a * x + b * y, c * x + d * y, outputScale));
		}
		drawing += `<path d="${transformed.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(" ")}" fill="rgb(143 22 77 / .08)" stroke="#8f164d" stroke-width="4"/>`;
		const directions: {
			x: number;
			y: number;
			label: string;
		}[] = [];
		const addDirection = (x: number, y: number, label: string) => {
			const n = Math.hypot(x, y);
			if (!Number.isFinite(n) || n === 0) return;
			const candidate = {
				x: x / n,
				y: y / n,
				label
			};
			if (directions.some((existing) => Math.abs(existing.x * candidate.y - existing.y * candidate.x) < 1e-10)) return;
			directions.push(candidate);
		};
		if (realRoots && !scalar) {
			if (!repeated && eb.num === 0n && ec.num === 0n) {
				const firstIsHorizontal = this.subtract(ea, ed).num > 0n;
				addDirection(1, 0, firstIsHorizontal ? "λ1" : "λ2");
				addDirection(0, 1, firstIsHorizontal ? "λ2" : "λ1");
			} else {
				const root = repeated ? 0 : Math.sqrt(Math.max(0, disc)), values = repeated ? [trace / 2] : [(trace + root) / 2, (trace - root) / 2];
				values.forEach((lambda, index) => {
					let v = eb.num !== 0n ? {
						x: b,
						y: lambda - a
					} : {
						x: lambda - d,
						y: c
					};
					let n = Math.hypot(v.x, v.y);
					if (!Number.isFinite(n) || n === 0) {
						v = ec.num !== 0n ? {
							x: lambda - d,
							y: c
						} : {
							x: b,
							y: lambda - a
						};
						n = Math.hypot(v.x, v.y);
					}
					addDirection(v.x, v.y, repeated ? "λ" : "λ" + (index + 1));
				});
			}
		}
		directions.forEach((v, index) => {
			drawing += line(point(-2.35 * v.x, -2.35 * v.y), point(2.35 * v.x, 2.35 * v.y), index ? "#945508" : "#23724a", 4, index ? "7 4" : "") + `<text x="${point(2.1 * v.x, 2.1 * v.y).x}" y="${point(2.1 * v.x, 2.1 * v.y).y}" fill="${index ? "#945508" : "#23724a"}" font-weight="700">${v.label}</text>`;
		});
		if (scalar) drawing += `<circle cx="${cx}" cy="${cy}" r="138" fill="rgb(20 125 121 / .07)" stroke="#147d79" stroke-width="3" stroke-dasharray="7 5"/><text x="${cx}" y="38" text-anchor="middle" fill="#147d79" font-weight="700">every direction is invariant</text>`;
		svg.innerHTML = drawing;
		const exactPolynomial = `χ(λ)=λ²−(${this.formatRational(exactTrace)})λ+(${this.formatRational(exactDet)})`, discDisplay = this.formatRational(exactDisc);
		const numericScale = Math.max(1, Math.abs(trace * trace), Math.abs(4 * det)), nearBoundary = Number.isFinite(disc) && disc !== 0 && Math.abs(disc) / numericScale < 1e-8;
		const numericalNote = nearBoundary ? "<br><em>Numerical state:</em> the exact nonzero discriminant is close to zero at browser scale; proximity does not change the exact branch." : "<br><em>Numerical state:</em> the approximate drawing does not determine the exact classification.";
		if (scalar) {
			const eigen = this.formatRational(ea);
			summary.innerHTML = `<strong>Exact scalar matrix A = (${eigen})I · ${exactPolynomial}</strong><br>The exact repeated eigenvalue is ${eigen}, with eigenspace ℝ²: every nonzero direction is invariant.${numericalNote}`;
			svg.setAttribute("aria-label", `Exact scalar matrix with repeated eigenvalue ${eigen}. Every nonzero real direction is an eigendirection. The transformed circle is an approximate drawing.`);
		} else if (realRoots) {
			const root = Math.sqrt(Math.max(0, disc)), l1 = (trace + root) / 2, l2 = (trace - root) / 2;
			if (repeated) {
				const geometry = directions.length === 1 ? "The single real eigendirection is drawn approximately." : "Exact classification is retained, but browser precision cannot resolve the approximate eigendirection, so no direction line is drawn.";
				summary.innerHTML = `<strong>${exactPolynomial} · exact discriminant 0</strong><br>There is one exact repeated real eigenvalue, approximately ${this.formatNumber(l1)}. Because the matrix is not scalar, its eigenspace is one-dimensional: this is the defective repeated-root case. ${geometry}${numericalNote}`;
				svg.setAttribute("aria-label", `Exact repeated real eigenvalue approximately ${this.formatNumber(l1)}. The matrix is not scalar. ${directions.length === 1 ? "One approximate real eigendirection is shown." : "Browser precision cannot resolve its approximate eigendirection, so no direction line is shown."}`);
			} else {
				const geometry = directions.length === 2 ? "Both real eigendirections are drawn approximately." : directions.length === 1 ? "Exact classification is retained, but browser precision resolves only one of the two approximate eigendirections; one direction line is drawn." : "Exact classification is retained, but browser precision cannot resolve the approximate eigendirections, so no direction line is drawn.";
				summary.innerHTML = `<strong>${exactPolynomial} · exact discriminant ${discDisplay} &gt; 0</strong><br>There are two exact distinct real roots, approximately ${this.formatNumber(l1)} and ${this.formatNumber(l2)}. ${geometry}${numericalNote}`;
				svg.setAttribute("aria-label", `Two exact distinct real eigenvalues, approximately ${this.formatNumber(l1)} and ${this.formatNumber(l2)}. ${directions.length === 2 ? "Two approximate real eigendirections are shown." : directions.length === 1 ? "Browser precision resolves one approximate eigendirection, so one direction line is shown." : "Browser precision cannot resolve the approximate eigendirections, so no direction line is shown."}`);
			}
