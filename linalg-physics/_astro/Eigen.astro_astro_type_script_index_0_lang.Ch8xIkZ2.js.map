			"b",
			"c",
			"d"
		], exactValues = keys.map((key) => this.decimal(this.raw(key)));
		keys.forEach((key, index) => this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.setAttribute("aria-invalid", String(exactValues[index] === null)));
