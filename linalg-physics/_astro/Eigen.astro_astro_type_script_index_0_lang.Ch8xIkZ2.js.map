	}
	formatRational(value: Rational) {
		if (value.num === 0n) return "0";
		let denominator = value.den, twos = 0, fives = 0;
		while (denominator % 2n === 0n) {
			denominator /= 2n;
			twos += 1;
		}
		while (denominator % 5n === 0n) {
			denominator /= 5n;
			fives += 1;
		}
		const places = Math.max(twos, fives);
		if (denominator === 1n) {
			const scaled = value.num * 2n ** BigInt(places - twos) * 5n ** BigInt(places - fives), negative = scaled < 0n;
			const rawDigits = (negative ? -scaled : scaled).toString(), exponent = rawDigits.length - places - 1, significant = rawDigits.replace(/0+$/, "");
			if (exponent >= -4 && exponent <= 8 && rawDigits.length <= 16) {
				const digits = rawDigits.padStart(places + 1, "0");
				const whole = places ? digits.slice(0, -places) : digits, fraction = places ? digits.slice(-places).replace(/0+$/, "") : "";
				return `${negative ? "−" : ""}${whole}${fraction ? `.${fraction}` : ""}`;
			}
			const coefficient = significant.length === 1 ? significant : `${significant[0]}.${significant.slice(1)}`;
			return `${negative ? "−" : ""}${coefficient} × 10^${exponent}`;
		}
		const approximate = this.toNumber(value);
		return Number.isFinite(approximate) && approximate !== 0 ? `${value.num}/${value.den} (≈ ${this.formatNumber(approximate)})` : `${value.num}/${value.den}`;
	}
	formatNumber(value: number) {
