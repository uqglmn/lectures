import { readEvidence } from "../lib/learningEvidence";
interface LectureLink {
	id: number;
	title: string;
	href: string;
}
interface ConceptLink {
	id: string;
	title: string;
	lecture: number;
}
class StudyDashboard extends HTMLElement {
	lectures: LectureLink[] = [];
	concepts: Record<string, ConceptLink> = {};
	connectedCallback() {
		this.lectures = JSON.parse(this.dataset.lectures || "[]");
		const concepts: ConceptLink[] = JSON.parse(this.dataset.concepts || "[]");
		this.concepts = Object.fromEntries(concepts.map((concept) => [concept.id, concept]));
		this.render();
		window.addEventListener("linalg-evidence-updated", () => this.render());
	}
	readArray(key: string): string[] {
		try {
			return JSON.parse(localStorage.getItem(key) || "[]");
		} catch {
			return [];
		}
	}
	readValue(key: string, fallback: string): string {
		try {
			return localStorage.getItem(key) || fallback;
		} catch {
			return fallback;
		}
	}
	escape(value: string) {
		return value.replace(/[&<>'"]/g, (char) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			"'": "&#39;",
			"\"": "&quot;"
		})[char] || char);
	}
	render() {
		const last = Number(this.readValue("linalg-last-lecture", "0"));
		const unfinished = this.lectures.filter((lecture) => this.readArray(`linalg-progress-${lecture.id}`).length < 4);
		const current = unfinished.find((lecture) => lecture.id === last) || unfinished.find((lecture) => lecture.id > last) || unfinished[0] || this.lectures.at(-1);
		const progress = current ? this.readArray(`linalg-progress-${current.id}`).length : 0;
		const continueCard = this.querySelector<HTMLElement>("[data-continue]");
		if (continueCard && current) continueCard.innerHTML = `<p class="card-label">Continue learning</p><span class="study-card-number">${String(current.id).padStart(2, "0")}</span><h3>${this.escape(current.title)}</h3><p>${progress}/4 learning steps recorded on this device.</p><a class="text-link" href="${current.href}">${progress ? "Resume lecture" : "Start lecture"} <span aria-hidden="true">→</span></a>`;
		const evidence = Object.values(readEvidence()).filter((item) => Boolean(this.concepts[item.conceptId]));
		const now = Date.now();
		const due = evidence.filter((item) => new Date(item.dueAt).getTime() <= now);
		const reviewCard = this.querySelector<HTMLElement>("[data-review]");
		if (reviewCard) reviewCard.innerHTML = `<p class="card-label">Cumulative retrieval</p><span class="study-due-count">${due.length}</span><h3>${due.length === 1 ? "concept due" : "concepts due"}</h3><p>${evidence.length ? "Mix earlier ideas into a focused five-to-eight question session." : "Complete a self-check to start a personalised review queue."}</p><a class="button secondary" href="${this.dataset.reviewHref}">${due.length ? "Review now" : "Open review centre"}</a>`;
		const fragile = evidence.filter((item) => item.outcome !== "independent").sort((a, b) => new Date(b.lastReviewed).getTime() - new Date(a.lastReviewed).getTime()).slice(0, 3);
		const evidenceCard = this.querySelector<HTMLElement>("[data-evidence]");
		if (evidenceCard) evidenceCard.innerHTML = `<p class="card-label">Learning evidence</p><h3>${evidence.length ? `${evidence.length} concepts encountered` : "No evidence yet"}</h3><p>${evidence.length ? "These labels describe retrieval evidence—not permanent mastery." : "Hints, retries and independent answers will shape this map."}</p>${fragile.length ? `<ul class="evidence-list">${fragile.map((item) => `<li><span>${this.escape(this.concepts[item.conceptId]?.title || item.conceptId)}</span><small>${item.outcome === "review" ? "Needs review" : "Developing"}</small></li>`).join("")}</ul>` : "<span class=\"evidence-empty\">Begin with Lecture 0 or your current week.</span>"}`;
	}
}
if (!customElements.get("study-dashboard")) customElements.define("study-dashboard", StudyDashboard);