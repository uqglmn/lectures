class ChangeBasisLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const s = this.get("s"), t = this.get("t"), p = this.get("p"), q = this.get("q"), kind = this.querySelector<HTMLSelectElement>("[data-map]")?.value || "shear";
		const maps: Record<string, number[][]> = {
			shear: [[1, 1], [0, 1]],
			reflection: [[1, 0], [0, -1]],
			rotation: [[0, -1], [1, 0]]
		}, A = maps[kind];
		const P = [[1, s], [0, t]], Pinv = [[1, -s / t], [0, 1 / t]];
		const multiply = (X: number[][], Y: number[][]) => X.map((row) => Y[0].map((_, j) => row.reduce((sum, value, k) => sum + value * Y[k][j], 0)));
		const C = multiply(multiply(Pinv, A), P), x = {
			x: p + s * q,
			y: t * q
		}, Ax = {
			x: A[0][0] * x.x + A[0][1] * x.y,
			y: A[1][0] * x.x + A[1][1] * x.y
		};
		const max = Math.max(2.5, Math.abs(x.x), Math.abs(x.y), Math.abs(Ax.x), Math.abs(Ax.y)) * 1.35, cx = 220, cy = 170, scale = 140 / max;
		const pt = (v: {
			x: number;
			y: number;
		}) => ({
			x: cx + v.x * scale,
			y: cy - v.y * scale
		}), line = (a: {
			x: number;
			y: number;
		}, b: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		const arrow = (v: {
			x: number;
			y: number;
		}, color: string, label: string) => {
			const e = pt(v);
			return `${line({
				x: cx,
				y: cy
			}, e, color, 4)}<circle cx="${e.x}" cy="${e.y}" r="5" fill="${color}"/><text x="${e.x + 7}" y="${e.y - 7}" fill="${color}" font-weight="700">${label}</text>`;
		};
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70") + arrow({
			x: 1,
			y: 0
		}, "#8f164d", "b₁") + arrow({
			x: s,
			y: t
		}, "#147d79", "b₂") + arrow(x, "#945508", "x") + arrow(Ax, "#23724a", "Ax");
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out=s]")!.textContent = s.toFixed(1);
		this.querySelector<HTMLOutputElement>("[data-out=t]")!.textContent = t.toFixed(1);
		const fmt = (M: number[][]) => `[${M[0].map((n) => n.toFixed(2)).join("  ")}; ${M[1].map((n) => n.toFixed(2)).join("  ")}]`;
		const imageCoordinates = {
			x: C[0][0] * p + C[0][1] * q,
			y: C[1][0] * p + C[1][1] * q
		};
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>[T]ᴮ = P⁻¹AP = ${fmt(C)}</strong><br>[x]ᴮ = (${p.toFixed(2)}, ${q.toFixed(2)}) and [Tx]ᴮ = (${imageCoordinates.x.toFixed(2)}, ${imageCoordinates.y.toFixed(2)}). Trace and determinant agree with A because similarity changes coordinates, not the operator.`;
	}
}
if (!customElements.get("change-basis-lab")) customElements.define("change-basis-lab", ChangeBasisLab);