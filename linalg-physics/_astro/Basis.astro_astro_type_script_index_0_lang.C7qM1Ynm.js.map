class BasisLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const v1 = {
			x: this.get("a"),
			y: this.get("b")
		}, v2 = {
			x: this.get("c"),
			y: this.get("d")
		}, target = {
			x: this.get("x"),
			y: this.get("y")
		};
		const det = v1.x * v2.y - v2.x * v1.y, independent = Math.abs(det) > 1e-8;
		const alpha = independent ? (target.x * v2.y - v2.x * target.y) / det : 0, beta = independent ? (v1.x * target.y - target.x * v1.y) / det : 0;
		const max = Math.max(3, Math.abs(v1.x), Math.abs(v1.y), Math.abs(v2.x), Math.abs(v2.y), Math.abs(target.x), Math.abs(target.y)) * 1.3;
		const cx = 220, cy = 170, s = 140 / max, pt = (q: {
			x: number;
			y: number;
		}) => ({
			x: cx + q.x * s,
			y: cy - q.y * s
		});
		const line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		const arrow = (q: {
			x: number;
			y: number;
		}, color: string, label: string) => {
			const e = pt(q);
			return `${line({
				x: cx,
				y: cy
			}, e, color, 4)}<circle cx="${e.x}" cy="${e.y}" r="5" fill="${color}"/><text x="${e.x + 7}" y="${e.y - 7}" fill="${color}" font-weight="700">${label}</text>`;
		};
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70") + arrow(v1, "#8f164d", "v₁") + arrow(v2, "#147d79", "v₂") + arrow(target, "#945508", "x");
		if (independent) {
			const p1 = {
				x: alpha * v1.x,
				y: alpha * v1.y
			};
			drawing += line(pt(p1), pt(target), "#147d79", 3, "6 4") + line({
				x: cx,
				y: cy
			}, pt(p1), "#8f164d", 3, "6 4");
		} else {
			const n = Math.hypot(v1.x, v1.y) > 1e-8 ? v1 : v2, nn = Math.hypot(n.x, n.y);
			if (nn > 1e-8) drawing += line(pt({
				x: -n.x * max / nn,
				y: -n.y * max / nn
			}), pt({
				x: n.x * max / nn,
				y: n.y * max / nn
			}), "#8f164d", 3, "7 5");
		}
		this.querySelector("svg")!.innerHTML = drawing;
		const summary = this.querySelector<HTMLElement>("[data-summary]")!;
		if (independent) summary.innerHTML = `<strong>det[v₁ v₂] = ${det.toFixed(3)} ≠ 0</strong><br>The list is independent, spans ℝ², and is a basis. [x]ᵦ = (${alpha.toFixed(3)}, ${beta.toFixed(3)}); these coordinates are unique.`;
		else summary.innerHTML = `<strong>det[v₁ v₂] = 0</strong><br>The vectors are dependent and span at most a line, so they are not a basis of ℝ². A target off that line has no coordinates; one on it has non-unique coefficients.`;
	}
}
if (!customElements.get("basis-lab")) customElements.define("basis-lab", BasisLab);