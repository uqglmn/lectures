class PerturbationLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	values(epsilon: number, gap: number, coupling: number, slope: number) {
		const half = gap / 2, root = Math.hypot(half - slope * epsilon, coupling * epsilon);
		return {
			exactLow: -root,
			exactHigh: root,
			firstLow: -half + slope * epsilon,
			firstHigh: half - slope * epsilon,
			secondLow: -half + slope * epsilon - coupling * coupling * epsilon * epsilon / gap,
			secondHigh: half - slope * epsilon + coupling * coupling * epsilon * epsilon / gap
		};
	}
	draw() {
		const epsilon = this.get("epsilon"), gap = this.get("gap"), coupling = this.get("coupling"), slope = this.get("slope");
		const samples = Array.from({ length: 161 }, (_, index) => -1 + 2 * index / 160);
		const series = samples.map((value) => ({
			epsilon: value,
			...this.values(value, gap, coupling, slope)
		}));
		const all = series.flatMap((point) => [
			point.exactLow,
			point.exactHigh,
			point.secondLow,
			point.secondHigh
		]);
		const pad = Math.max(.35, (Math.max(...all) - Math.min(...all)) * .08), yMin = Math.min(...all) - pad, yMax = Math.max(...all) + pad;
		const x = (value: number) => 58 + (value + 1) / 2 * 420, y = (value: number) => 292 - (value - yMin) / (yMax - yMin) * 244;
		const path = (key: "exactLow" | "exactHigh" | "firstLow" | "firstHigh" | "secondLow" | "secondHigh") => series.map((point, index) => `${index ? "L" : "M"}${x(point.epsilon).toFixed(1)},${y(point[key]).toFixed(1)}`).join(" ");
		let drawing = "";
		for (let index = 0; index <= 4; index++) {
			const px = 58 + index * 105, value = -1 + index * .5;
			drawing += `<line x1="${px}" y1="48" x2="${px}" y2="292" stroke="#ece7e9"/><text x="${px}" y="314" text-anchor="middle" fill="#626b7c" font-size="11">${value.toFixed(1)}</text>`;
		}
		for (let index = 0; index <= 4; index++) {
			const value = yMin + (yMax - yMin) * index / 4, py = y(value);
			drawing += `<line x1="58" y1="${py}" x2="478" y2="${py}" stroke="#ece7e9"/><text x="49" y="${py + 4}" text-anchor="end" fill="#626b7c" font-size="11">${value.toFixed(1)}</text>`;
		}
		drawing += `<line x1="58" y1="292" x2="478" y2="292" stroke="#746a70"/><text x="268" y="334" text-anchor="middle" fill="#626b7c">ε</text>`;
		drawing += `<path d="${path("firstLow")}" fill="none" stroke="#9b9297" stroke-width="2" stroke-dasharray="3 6"/><path d="${path("firstHigh")}" fill="none" stroke="#9b9297" stroke-width="2" stroke-dasharray="3 6"/>`;
		drawing += `<path d="${path("secondLow")}" fill="none" stroke="#bf6d19" stroke-width="2.5" stroke-dasharray="8 5"/><path d="${path("secondHigh")}" fill="none" stroke="#bf6d19" stroke-width="2.5" stroke-dasharray="8 5"/>`;
		drawing += `<path d="${path("exactLow")}" fill="none" stroke="#64113f" stroke-width="4"/><path d="${path("exactHigh")}" fill="none" stroke="#147d79" stroke-width="4"/>`;
		const current = this.values(epsilon, gap, coupling, slope), px = x(epsilon), norm = Math.hypot(slope, coupling), radius = Math.abs(epsilon) * norm, half = gap / 2;
		for (const centre of [-half, half]) drawing += `<line x1="${px}" y1="${y(centre - radius)}" x2="${px}" y2="${y(centre + radius)}" stroke="#f4b95f" stroke-width="12" opacity=".38"/>`;
		drawing += `<line x1="${px}" y1="48" x2="${px}" y2="292" stroke="#263a50" stroke-width="2" stroke-dasharray="5 5"/><circle cx="${px}" cy="${y(current.exactLow)}" r="6" fill="#64113f"/><circle cx="${px}" cy="${y(current.exactHigh)}" r="6" fill="#147d79"/>`;
		drawing += `<g font-size="11" font-weight="700"><text x="66" y="22" fill="#64113f">exact</text><text x="112" y="22" fill="#bf6d19">– – second order</text><text x="224" y="22" fill="#746a70">··· first order</text><text x="330" y="22" fill="#a36b12">stability interval</text></g>`;
		this.querySelector("svg")!.innerHTML = drawing;
		for (const key of [
			"epsilon",
			"gap",
			"coupling",
			"slope"
		]) this.querySelector<HTMLOutputElement>(`[data-out=${key}]`)!.textContent = this.get(key).toFixed(2);
		const lowError = Math.abs(current.secondLow - current.exactLow), highError = Math.abs(current.secondHigh - current.exactHigh), ratio = Math.abs(epsilon) * Math.abs(coupling) / gap;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>Exact E₋=${current.exactLow.toFixed(3)}, E₊=${current.exactHigh.toFixed(3)}</strong><br>Second order: ${current.secondLow.toFixed(3)}, ${current.secondHigh.toFixed(3)} · largest error ${Math.max(lowError, highError).toFixed(3)}.<br>Coupling-to-gap ratio |εc|/Δ=${ratio.toFixed(3)}; stability radius |ε|‖V‖=${radius.toFixed(3)}.`;
	}
}
if (!customElements.get("perturbation-lab")) customElements.define("perturbation-lab", PerturbationLab);