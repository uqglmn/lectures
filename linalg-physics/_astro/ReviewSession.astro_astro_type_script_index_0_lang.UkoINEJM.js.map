import { readEvidence, recordConceptEvidence } from "../lib/learningEvidence";
interface Question {
	id: string;
	type: "choice" | "numeric";
	prompt: string;
	options?: string[];
	answer: number;
	tolerance?: number;
	hint: string;
	explanation: string;
	concepts: string[];
	lecture: number;
	lectureTitle: string;
	href: string;
}
interface Result {
	id: string;
	correct: boolean;
	independent: boolean;
	lecture: number;
}
class ReviewSession extends HTMLElement {
	source: Question[] = [];
	questions: Question[] = [];
	current = 0;
	attempts = 0;
	hintUsed = false;
	results: Result[] = [];
	body!: HTMLElement;
	progress!: HTMLElement;
	phase = 0;
	connectedCallback() {
		this.source = JSON.parse(this.dataset.questions || "[]");
		this.body = this.querySelector(".review-session-body") as HTMLElement;
		this.progress = this.querySelector(".review-session-progress") as HTMLElement;
		this.prepare();
		this.render();
	}
	escape(value: string) {
		return value.replace(/[&<>'"]/g, (char) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			"'": "&#39;",
			"\"": "&quot;"
		})[char] || char);
	}
	shuffled<T,>(items: T[]): T[] {
		const result = [...items];
		for (let i = result.length - 1; i > 0; i--) {
			const random = new Uint32Array(1);
			crypto.getRandomValues(random);
			const j = random[0] % (i + 1);
			[result[i], result[j]] = [result[j], result[i]];
		}
		return result;
	}
	prepareQuestion(question: Question): Question {
		if (question.type !== "choice" || !question.options) return { ...question };
		const options = this.shuffled(question.options.map((label, index) => ({
			label,
			correct: index === question.answer
		})));
		return {
			...question,
			options: options.map((option) => option.label),
			answer: options.findIndex((option) => option.correct)
		};
	}
	lastLecture(): number {
		try {
			return Number(localStorage.getItem("linalg-last-lecture") || 0);
		} catch {
			return 0;
		}
	}
	prepare() {
		const params = new URLSearchParams(location.search);
		this.phase = Number(params.get("phase") || 0);
		const evidence = readEvidence();
		let pool: Question[] = [];
		if (this.phase >= 1 && this.phase <= 3) {
			const maximum = [
				0,
				4,
				10,
				14
			][this.phase];
			pool = this.source.filter((question) => question.lecture <= maximum);
		} else {
			const now = Date.now(), maximum = this.lastLecture();
			pool = this.source.filter((question) => question.lecture <= maximum && question.concepts.some((id) => evidence[id] && new Date(evidence[id].dueAt).getTime() <= now));
		}
		const unique: Question[] = [];
		const used = new Set<string>();
		for (const question of this.shuffled(pool)) {
			const fresh = question.concepts.find((id) => !used.has(id));
			if (!fresh && unique.length < 5) continue;
			unique.push(question);
			question.concepts.forEach((id) => used.add(id));
			if (unique.length === 8) break;
		}
		this.questions = unique.map((question) => this.prepareQuestion(question));
	}
	setProgress(value: number) {
		const total = Math.max(this.questions.length, 1);
		this.progress.setAttribute("aria-valuemax", String(this.questions.length));
		this.progress.setAttribute("aria-valuenow", String(value));
		this.progress.setAttribute("aria-valuetext", `${value} of ${this.questions.length} questions completed`);
		const bar = this.progress.querySelector<HTMLElement>("span");
		if (bar) bar.style.width = `${value / total * 100}%`;
	}
	render(focus = false) {
		if (!this.questions.length) {
			this.setProgress(0);
			this.body.innerHTML = `<div class="review-empty"><p class="quiz-kicker">Review queue clear</p><h2>${this.phase ? "No checkpoint questions are available." : "Nothing is due yet"}</h2><p>${this.phase ? "Return to the course map and complete the released lectures first." : "Complete a lecture self-check, or choose a cumulative phase checkpoint below."}</p><a class="button" href="${this.dataset.lectureZero}">Open Lecture 0</a></div>`;
			return;
		}
		if (this.current >= this.questions.length) {
			this.finish(focus);
			return;
		}
		const question = this.questions[this.current];
		this.attempts = 0;
		this.hintUsed = false;
		this.setProgress(this.current);
		const answer = question.type === "choice" ? `<div class="quiz-options">${(question.options || []).map((option, index) => `<label class="quiz-option"><input type="radio" name="review-${this.current}" value="${index}"/><span>${this.escape(option)}</span></label>`).join("")}</div>` : `<label class="control-group quiz-number-answer"><span>Your answer</span><input class="number-field" type="number" step="any" inputmode="decimal" data-numeric/></label>`;
		this.body.innerHTML = `<div class="review-question-meta"><span>${this.phase ? `Phase ${this.phase} checkpoint` : "Due review"}</span><a href="${question.href}">Lecture ${question.lecture}: ${this.escape(question.lectureTitle)}</a></div><p class="quiz-kicker">Question ${this.current + 1} of ${this.questions.length}</p><fieldset class="quiz-fieldset"><legend class="quiz-question" data-review-focus tabindex="-1">${this.escape(question.prompt)}</legend>${answer}</fieldset><div class="quiz-feedback" role="status" aria-live="polite"></div><div class="quiz-actions"><button class="small-button" data-action="check">Check answer</button><button class="small-button secondary" data-action="hint">Use a hint</button></div>`;
		this.body.querySelector("[data-action=check]")?.addEventListener("click", () => this.check(question));
		this.body.querySelector("[data-action=hint]")?.addEventListener("click", () => {
			this.hintUsed = true;
			this.feedback(`Hint: ${question.hint}`, "hint");
		});
		if (focus) requestAnimationFrame(() => this.body.querySelector<HTMLElement>("[data-review-focus]")?.focus());
	}
	feedback(message: string, kind: string) {
		const area = this.body.querySelector<HTMLElement>(".quiz-feedback");
		if (area) {
			area.className = `quiz-feedback ${kind}`;
			area.textContent = message;
		}
	}
	selected(question: Question): number | null {
		if (question.type === "numeric") {
			const input = this.body.querySelector<HTMLInputElement>("[data-numeric]");
			return input && input.value !== "" ? Number(input.value) : null;
		}
		const input = this.body.querySelector<HTMLInputElement>("input[type=\"radio\"]:checked");
		return input ? Number(input.value) : null;
	}
	check(question: Question) {
		const selected = this.selected(question);
		if (selected === null || Number.isNaN(selected)) {
			this.feedback("Choose or enter an answer first.", "incorrect");
			return;
		}
		this.attempts += 1;
		const correct = question.type === "numeric" ? Math.abs(selected - question.answer) <= (question.tolerance || 0) : selected === question.answer;
		if (!correct && this.attempts < 2) {
			this.feedback("Not yet. Reconsider it or use the hint, then try once more.", "incorrect");
			return;
		}
		const independent = correct && this.attempts === 1 && !this.hintUsed;
		this.results.push({
			id: question.id,
			correct,
			independent,
			lecture: question.lecture
		});
		recordConceptEvidence(question.concepts, correct ? independent ? "independent" : "recovered" : "review", "review", question.id);
		this.feedback(`${correct ? independent ? "Retrieved independently. " : "Recovered after revisiting it. " : "Keep this in the review queue. "}${question.explanation}`, correct ? "correct" : "incorrect");
		const actions = this.body.querySelector<HTMLElement>(".quiz-actions");
		if (actions) {
			actions.innerHTML = `<button class="small-button" data-action="next">${this.current + 1 === this.questions.length ? "See review summary" : "Next question"}</button>`;
			actions.querySelector("button")?.addEventListener("click", () => {
				this.current += 1;
				this.render(true);
			});
		}
	}
	finish(focus: boolean) {
		this.setProgress(this.questions.length);
		const correct = this.results.filter((result) => result.correct).length, independent = this.results.filter((result) => result.independent).length;
		this.body.innerHTML = `<div class="review-finish" data-review-focus tabindex="-1"><p class="quiz-kicker">${this.phase ? `Phase ${this.phase} checkpoint complete` : "Review complete"}</p><h2>${correct}/${this.questions.length} correct · ${independent} independently</h2><p>Correct answers are scheduled later; recovered and missed ideas return sooner.</p><div class="button-row"><button class="small-button" data-action="restart">Build another set</button><a class="button secondary" href="${this.dataset.lectureZero}">Return to lectures</a></div></div>`;
		try {
			const history = JSON.parse(localStorage.getItem("linalg-review-history-v1") || "[]");
			history.unshift({
				phase: this.phase,
				correct,
				independent,
				total: this.questions.length,
				completedAt: new Date().toISOString()
			});
			localStorage.setItem("linalg-review-history-v1", JSON.stringify(history.slice(0, 20)));
			if (this.phase) localStorage.setItem(`linalg-phase-${this.phase}`, new Date().toISOString());
		} catch {}
		this.body.querySelector("[data-action=restart]")?.addEventListener("click", () => {
			this.current = 0;
			this.results = [];
			this.prepare();
			this.render(true);
		});
		if (focus) requestAnimationFrame(() => this.body.querySelector<HTMLElement>("[data-review-focus]")?.focus());
	}
}
if (!customElements.get("review-session")) customElements.define("review-session", ReviewSession);