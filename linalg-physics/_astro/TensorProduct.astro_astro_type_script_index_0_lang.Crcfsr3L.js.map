class TensorProductLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	degrees(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)!.value);
	}
	radians(key: string) {
		return this.degrees(key) * Math.PI / 180;
	}
	fmt(value: number) {
		const rounded = Number(value.toFixed(3));
		return rounded === 0 || Object.is(rounded, -0) ? "0.000" : rounded.toFixed(3);
	}
	draw() {
		const family = this.querySelector<HTMLSelectElement>("[data-family]")?.value || "bell", thetaDeg = this.degrees("theta"), theta = this.radians("theta"), alpha = this.radians("alpha"), beta = this.radians("beta");
		let coefficients: number[];
		if (family === "bell") coefficients = [
			Math.cos(theta),
			0,
			0,
			Math.sin(theta)
		];
		else coefficients = [
			Math.cos(alpha) * Math.cos(beta),
			Math.cos(alpha) * Math.sin(beta),
			Math.sin(alpha) * Math.cos(beta),
			Math.sin(alpha) * Math.sin(beta)
		];
		const rawDeterminant = coefficients[0] * coefficients[3] - coefficients[1] * coefficients[2];
		const determinant = family === "product" || family === "bell" && (thetaDeg === 0 || thetaDeg === 90) ? 0 : rawDeterminant, labels = [
			"|00⟩",
			"|01⟩",
			"|10⟩",
			"|11⟩"
		], max = Math.max(...coefficients.map(Math.abs), .001);
		const rank = family === "product" ? 1 : thetaDeg === 0 || thetaDeg === 90 ? 1 : 2, factorable = rank === 1, probA0 = coefficients[0] ** 2 + coefficients[1] ** 2;
		const grid = this.querySelector<HTMLElement>("[data-grid]")!;
		grid.innerHTML = coefficients.map((value, index) => `<div class="coefficient-cell"><span>${labels[index]}</span><div><i style="height:${Math.abs(value) / max * 100}%"></i></div><strong>${this.fmt(value)}</strong></div>`).join("");
		grid.setAttribute("aria-label", `${family === "product" ? "Product" : "Bell-type"} normalized two-qubit pure state. Coefficient matrix entries ${coefficients.map((value) => this.fmt(value)).join(", ")}; determinant ${this.fmt(determinant)}; rank ${rank}; ${factorable ? "product" : "entangled"} pure-state verdict; first-qubit-zero probability ${this.fmt(probA0)}.`);
		this.querySelector<HTMLElement>("[data-product-controls]")!.hidden = family !== "product";
		this.querySelector<HTMLElement>("[data-theta-group]")!.hidden = family !== "bell";
		for (const key of [
			"theta",
			"alpha",
			"beta"
		]) this.querySelector<HTMLOutputElement>(`[data-out=${key}]`)!.textContent = `${this.degrees(key)}°`;
		const familyLabel = family === "product" ? "exact product family" : "Bell-type family";
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>${familyLabel} · det C=${this.fmt(determinant)} · rank C=${rank}</strong><br>${factorable ? "This nonzero normalized pure-state vector factors as a tensor product." : "This nonzero normalized pure-state vector has rank two and is entangled."} The first-qubit outcome 0 has probability ${this.fmt(probA0)}.`;
	}
}
if (!customElements.get("tensor-product-lab")) customElements.define("tensor-product-lab", TensorProductLab);