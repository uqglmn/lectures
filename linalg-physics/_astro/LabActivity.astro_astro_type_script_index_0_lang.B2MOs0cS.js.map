interface Challenge {
	id: string;
	prompt: string;
	options: string[];
	answer: number;
	hint: string;
	explanation: string;
	preset?: Record<string, string | number | boolean>;
}
interface Result {
	id: string;
	correct: boolean;
	independent: boolean;
}
class LabActivity extends HTMLElement {
	challenges: Challenge[] = [];
	current = 0;
	attempts = 0;
	hintUsed = false;
	results: Result[] = [];
	body!: HTMLElement;
	progress!: HTMLElement;
	connectedCallback() {
		this.challenges = JSON.parse(this.dataset.challenges || "[]");
		this.body = this.querySelector(".lab-activity-body") as HTMLElement;
		this.progress = this.querySelector(".lab-activity-progress") as HTMLElement;
		this.renderHistory();
		this.render();
	}
	escape(value: string) {
		return value.replace(/[&<>'"]/g, (char) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			"'": "&#39;",
			"\"": "&quot;"
		})[char] || char);
	}
	detailKey() {
		return `linalg-lab-${this.dataset.lecture}-${this.dataset.lab}`;
	}
	aggregateKey() {
		return `linalg-labs-${this.dataset.lecture}`;
	}
	read<T,>(key: string, fallback: T): T {
		try {
			return JSON.parse(localStorage.getItem(key) || "") as T;
		} catch {
			return fallback;
		}
	}
	renderHistory() {
		const history = this.querySelector<HTMLElement>("[data-activity-history]");
		const stored = this.read<{
			completedAt?: string;
			independent?: number;
			total?: number;
		} | null>(this.detailKey(), null);
		if (!history || !stored) return;
		history.hidden = false;
		history.textContent = `Completed · ${stored.independent || 0}/${stored.total || this.challenges.length} independent`;
	}
	setProgress(value: number) {
		this.progress.setAttribute("aria-valuenow", String(value));
		this.progress.setAttribute("aria-valuetext", `${value} of ${this.challenges.length} challenges completed`);
		const bar = this.progress.querySelector<HTMLElement>("span");
		if (bar) bar.style.width = `${value / this.challenges.length * 100}%`;
	}
	render(focus = false) {
		if (this.current >= this.challenges.length) {
			this.finish(focus);
			return;
		}
		const challenge = this.challenges[this.current];
		this.attempts = 0;
		this.hintUsed = false;
		this.setProgress(this.current);
		this.body.innerHTML = `
        <p class="lab-challenge-number">Challenge ${this.current + 1} of ${this.challenges.length}</p>
        <fieldset class="lab-challenge-fieldset">
          <legend data-activity-focus tabindex="-1">${this.escape(challenge.prompt)}</legend>
          <div class="lab-challenge-options">${challenge.options.map((option, index) => `<label><input type="radio" name="lab-${this.dataset.lab}-${this.current}" value="${index}"/><span>${this.escape(option)}</span></label>`).join("")}</div>
        </fieldset>
        <div class="lab-challenge-feedback" role="status" aria-live="polite"></div>
        <div class="lab-challenge-actions">
          <button class="small-button" data-action="check">Test prediction</button>
          <button class="small-button secondary" data-action="hint">Use a hint</button>
        </div>`;
		this.body.querySelector("[data-action=check]")?.addEventListener("click", () => this.check(challenge));
		this.body.querySelector("[data-action=hint]")?.addEventListener("click", () => {
			this.hintUsed = true;
			this.feedback(`Hint: ${challenge.hint}`, "hint");
		});
		if (focus) requestAnimationFrame(() => this.body.querySelector<HTMLElement>("[data-activity-focus]")?.focus());
	}
	feedback(message: string, kind: string) {
		const area = this.body.querySelector<HTMLElement>(".lab-challenge-feedback");
		if (area) {
			area.className = `lab-challenge-feedback ${kind}`;
			area.textContent = message;
		}
	}
	applyPreset(challenge: Challenge) {
		const sequence = this.closest(".lab-learning-sequence");
		const card = sequence?.querySelector(".interactive-card");
		if (!card || !challenge.preset) return;
		for (const [key, value] of Object.entries(challenge.preset)) {
			const field = card.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-key="${key}"], [data-${key}]`);
			if (!field) continue;
			if (field instanceof HTMLInputElement && field.type === "checkbox") field.checked = Boolean(value);
			else field.value = String(value);
			field.dispatchEvent(new Event("input", { bubbles: true }));
		}
	}
	check(challenge: Challenge) {
		const selected = this.body.querySelector<HTMLInputElement>("input[type=\"radio\"]:checked");
		if (!selected) {
			this.feedback("Choose a prediction first.", "incorrect");
			return;
		}
		this.attempts += 1;
		const correct = Number(selected.value) === challenge.answer;
		this.applyPreset(challenge);
		if (!correct && this.attempts < 2) {
			this.feedback("Not yet. The setup is now loaded in the model. Inspect it or use the hint, then try once more.", "incorrect");
			return;
		}
		const independent = correct && this.attempts === 1 && !this.hintUsed;
		this.results.push({
			id: challenge.id,
			correct,
			independent
		});
		this.feedback(`${correct ? independent ? "Prediction confirmed independently. " : "Prediction recovered. " : "Mark this one for review. "}${challenge.explanation}`, correct ? "correct" : "incorrect");
		const actions = this.body.querySelector<HTMLElement>(".lab-challenge-actions");
		if (actions) {
			actions.innerHTML = `<button class="small-button" data-action="next">${this.current + 1 === this.challenges.length ? "Complete laboratory" : "Next challenge"}</button><button class="small-button secondary" data-action="inspect">Inspect model</button>`;
			actions.querySelector("[data-action=next]")?.addEventListener("click", () => {
				this.current += 1;
				this.render(true);
			});
			actions.querySelector("[data-action=inspect]")?.addEventListener("click", () => this.closest(".lab-learning-sequence")?.querySelector<HTMLElement>(".interactive-card")?.scrollIntoView({
				behavior: "smooth",
				block: "start"
			}));
		}
	}
	finish(focus: boolean) {
		this.setProgress(this.challenges.length);
		const independent = this.results.filter((result) => result.independent).length, correct = this.results.filter((result) => result.correct).length;
		this.body.innerHTML = `<div class="lab-activity-finish" data-activity-focus tabindex="-1"><p class="lab-challenge-number">Laboratory complete</p><h4>${correct}/${this.challenges.length} correct · ${independent} independently</h4><p>Use the model freely now, or revisit a source-linked concept before taking the lecture self-check.</p><button class="small-button" data-action="restart">Start fresh challenges</button></div>`;
		const stored = {
			correct,
			independent,
			total: this.challenges.length,
			completedAt: new Date().toISOString()
		};
		try {
			localStorage.setItem(this.detailKey(), JSON.stringify(stored));
			const completed = this.read<string[]>(this.aggregateKey(), []);
			if (!completed.includes(this.dataset.lab || "")) completed.push(this.dataset.lab || "");
			localStorage.setItem(this.aggregateKey(), JSON.stringify(completed));
		} catch {}
		this.renderHistory();
		window.dispatchEvent(new CustomEvent("linalg-lab-complete", { detail: {
			lecture: this.dataset.lecture,
			lab: this.dataset.lab
		} }));
		this.body.querySelector("[data-action=restart]")?.addEventListener("click", () => {
			this.current = 0;
			this.results = [];
			this.render(true);
		});
		if (focus) requestAnimationFrame(() => this.body.querySelector<HTMLElement>("[data-activity-focus]")?.focus());
	}
}
if (!customElements.get("lab-activity")) customElements.define("lab-activity", LabActivity);