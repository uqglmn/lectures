class DualSpaceLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)!.value);
	}
	fmt(value: number) {
		return Object.is(value, -0) ? "0" : Number(value.toFixed(3)).toString();
	}
	draw() {
		const a = this.get("a"), b = this.get("b"), v = {
			x: this.get("x"),
			y: this.get("y")
		}, kind = this.querySelector<HTMLSelectElement>("[data-map]")?.value || "shear";
		for (const key of [
			"a",
			"b",
			"x",
			"y"
		]) this.querySelector<HTMLOutputElement>(`[data-out=${key}]`)!.textContent = this.fmt(this.get(key));
		const maps: Record<string, number[][]> = {
			shear: [[1, 1], [0, 1]],
			scale: [[2, 0], [0, .5]],
			rotate: [[0, -1], [1, 0]]
		}, A = maps[kind];
		const Tv = {
			x: A[0][0] * v.x + A[0][1] * v.y,
			y: A[1][0] * v.x + A[1][1] * v.y
		};
		const pull = {
			x: A[0][0] * a + A[1][0] * b,
			y: A[0][1] * a + A[1][1] * b
		};
		const zero = a === 0 && b === 0;
		const after = a * Tv.x + b * Tv.y, pulled = pull.x * v.x + pull.y * v.y;
		const drawPlane = (svg: SVGElement, vector: {
			x: number;
			y: number;
		}, normal: {
			x: number;
			y: number;
		}, plane: "domain" | "codomain") => {
			const cx = 150, cy = 145, extent = Math.max(2.6, Math.abs(vector.x), Math.abs(vector.y)), s = Math.min(42, 105 / extent);
			const pt = (q: {
				x: number;
				y: number;
			}) => ({
				x: cx + q.x * s,
				y: cy - q.y * s
			});
			const line = (p: {
				x: number;
				y: number;
			}, q: {
				x: number;
				y: number;
			}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
			const clipId = `dual-${plane}-clip`;
			let drawing = `<defs><clipPath id="${clipId}"><rect x="18" y="32" width="264" height="228" rx="4"/></clipPath></defs>`;
			for (let i = -4; i <= 4; i++) drawing += line({
				x: cx + i * 30,
				y: 35
			}, {
				x: cx + i * 30,
				y: 258
			}, "#ece7e9") + line({
				x: 20,
				y: cy + i * 30
			}, {
				x: 280,
				y: cy + i * 30
			}, "#ece7e9");
			drawing += line({
				x: 20,
				y: cy
			}, {
				x: 280,
				y: cy
			}, "#746a70") + line({
				x: cx,
				y: 260
			}, {
				x: cx,
				y: 32
			}, "#746a70");
			const familyColor = plane === "domain" ? "#8f164d" : "#147d79", dash = plane === "domain" ? "8 5" : "";
			if (!zero) {
				const norm = Math.hypot(normal.x, normal.y), unit = {
					x: normal.x / norm,
					y: normal.y / norm
				}, tangent = {
					x: -unit.y,
					y: unit.x
				};
				let family = "";
				for (let k = -2; k <= 2; k++) {
					const center = {
						x: unit.x * k * .85,
						y: unit.y * k * .85
					};
					family += line(pt({
						x: center.x - 8 * tangent.x,
						y: center.y - 8 * tangent.y
					}), pt({
						x: center.x + 8 * tangent.x,
						y: center.y + 8 * tangent.y
					}), familyColor, k === 0 ? 3.5 : 2, dash);
				}
				drawing += `<g clip-path="url(#${clipId})">${family}</g>`;
				drawing += line({
					x: cx,
					y: cy
				}, pt({
					x: unit.x * 1.15,
					y: unit.y * 1.15
				}), familyColor, 4, dash);
			}
			const end = pt(vector), vectorColor = plane === "domain" ? "#945508" : "#23724a", vectorLabel = plane === "domain" ? "v" : "Tv", familyLabel = plane === "domain" ? "T′φ levels" : "φ levels";
			drawing += line({
				x: cx,
				y: cy
			}, end, vectorColor, 5) + `<circle cx="${end.x}" cy="${end.y}" r="5" fill="${vectorColor}"/><text x="${end.x + 7}" y="${end.y - 7}" fill="${vectorColor}" font-size="14" font-weight="700">${vectorLabel}</text>`;
			drawing += `<text x="24" y="24" fill="${familyColor}" font-size="14" font-weight="700">${familyLabel}</text>`;
			svg.innerHTML = drawing;
		};
		const domainSvg = this.querySelector<SVGElement>("[data-plane=\"domain\"]")!, codomainSvg = this.querySelector<SVGElement>("[data-plane=\"codomain\"]")!, summary = this.querySelector<HTMLElement>("[data-summary]")!;
		drawPlane(domainSvg, v, pull, "domain");
		drawPlane(codomainSvg, Tv, {
			x: a,
			y: b
		}, "codomain");
		if (zero) {
			summary.innerHTML = `<strong>Exact zero covector: φ=(0,0), T′φ=(0,0), and φ(Tv)=(T′φ)(v)=0.</strong><br>The domain kernel ker(T′φ) and codomain kernel ker φ are their full planes. Every nonzero level set is empty, and no nonzero Riesz normals or affine level-line families are drawn.`;
			domainSvg.setAttribute("aria-label", `Domain V. Exact zero pullback covector. Its kernel is the full domain plane, nonzero level sets are empty, and no nonzero Riesz normal is drawn. v is (${this.fmt(v.x)}, ${this.fmt(v.y)}).`);
			codomainSvg.setAttribute("aria-label", `Codomain W. Exact zero covector. Its kernel is the full codomain plane, nonzero level sets are empty, and no nonzero Riesz normal is drawn. T v is (${this.fmt(Tv.x)}, ${this.fmt(Tv.y)}). Both well-typed evaluations are zero.`);
		} else {
			summary.innerHTML = `<strong>φ(Tv)=${this.fmt(after)} = (T′φ)(v)=${this.fmt(pulled)}</strong><br>Tv=(${this.fmt(Tv.x)}, ${this.fmt(Tv.y)}) and T′φ=Aᵀφ=(${this.fmt(pull.x)}, ${this.fmt(pull.y)}). The domain panel evaluates T′φ at v; the codomain panel evaluates φ at Tv.`;
			domainSvg.setAttribute("aria-label", `Domain V with vector v (${this.fmt(v.x)}, ${this.fmt(v.y)}) and level lines of pullback T prime phi (${this.fmt(pull.x)}, ${this.fmt(pull.y)}). Its evaluation at v is ${this.fmt(pulled)}.`);
			codomainSvg.setAttribute("aria-label", `Codomain W with mapped vector T v (${this.fmt(Tv.x)}, ${this.fmt(Tv.y)}) and level lines of phi (${this.fmt(a)}, ${this.fmt(b)}). Phi of T v is ${this.fmt(after)}, equal to the domain pullback evaluation.`);
		}
	}
}
if (!customElements.get("dual-space-lab")) customElements.define("dual-space-lab", DualSpaceLab);