class MatrixDynamicsLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const mode = this.querySelector<HTMLSelectElement>("[data-mode]")?.value || "diagonal", steps = this.get("steps"), start = {
			x: this.get("x"),
			y: this.get("y")
		};
		const angle = Math.PI / 10, matrices: Record<string, number[][]> = {
			diagonal: [[1.15, 0], [0, .78]],
			jordan: [[1, .28], [0, 1]],
			rotation: [[Math.cos(angle), -Math.sin(angle)], [Math.sin(angle), Math.cos(angle)]]
		}, A = matrices[mode];
		const orbit = [start];
		for (let i = 0; i < steps; i++) {
			const v = orbit[orbit.length - 1];
			orbit.push({
				x: A[0][0] * v.x + A[0][1] * v.y,
				y: A[1][0] * v.x + A[1][1] * v.y
			});
		}
		const max = Math.max(2, ...orbit.flatMap((v) => [Math.abs(v.x), Math.abs(v.y)])) * 1.25, cx = 220, cy = 170, s = 140 / max, pt = (v: {
			x: number;
			y: number;
		}) => ({
			x: cx + v.x * s,
			y: cy - v.y * s
		});
		const line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70");
		drawing += `<path d="${orbit.map((v, i) => {
			const p = pt(v);
			return `${i ? "L" : "M"}${p.x} ${p.y}`;
		}).join(" ")}" fill="none" stroke="#8f164d" stroke-width="3"/>`;
		orbit.forEach((v, i) => {
			const p = pt(v);
			drawing += `<circle cx="${p.x}" cy="${p.y}" r="${i === steps ? 6 : 4}" fill="${i === steps ? "#945508" : "#8f164d"}"/><text x="${p.x + 6}" y="${p.y - 6}" fill="#626b7c" font-size="11">${i}</text>`;
		});
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out]")!.textContent = String(steps);
		const end = orbit[orbit.length - 1];
		const explanations: Record<string, string> = {
			diagonal: "An eigenbasis separates the expanding λ=1.15 direction from the contracting λ=0.78 direction; powers act on the two coordinates independently.",
			jordan: "The repeated eigenvalue is 1, but the missing eigenvector creates the linear drift kN. This is the behaviour diagonalization cannot capture.",
			rotation: "The real plane has no eigendirection. Over ℂ, the eigenvalues e^{±iπ/10} are mapped to their powers, producing rotation by kπ/10."
		};
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>A<sup>${steps}</sup>x = (${end.x.toFixed(3)}, ${end.y.toFixed(3)})</strong><br>${explanations[mode]} Cayley–Hamilton guarantees every higher power reduces to a combination of I and A.`;
	}
}
if (!customElements.get("matrix-dynamics-lab")) customElements.define("matrix-dynamics-lab", MatrixDynamicsLab);