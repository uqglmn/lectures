class BasisLab extends HTMLElement {
	readonly maxExactDigits = 24;
	readonly maxExactScale = 100;
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	raw(key: string) {
		return this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value ?? "";
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	gcd(a: bigint, b: bigint) {
		a = a < 0n ? -a : a;
		b = b < 0n ? -b : b;
		while (b) {
			const remainder = a % b;
			a = b;
			b = remainder;
		}
		return a || 1n;
	}
	rational(num: bigint, den: bigint) {
		if (den < 0n) {
			num = -num;
			den = -den;
		}
		const divisor = this.gcd(num, den);
		return {
			num: num / divisor,
			den: den / divisor
		};
	}
	decimal(value: string) {
		const raw = value.trim();
		if (raw.length > 64) return null;
		const match = raw.match(/^([+-]?)(?:(\d+)(?:\.(\d*))?|\.(\d+))(?:[eE]([+-]?\d+))?$/);
		if (!match) return null;
		const fraction = match[3] ?? match[4] ?? "", integer = match[2] ?? "0", exponent = Number(match[5] || 0);
		const digits = (integer + fraction).replace(/^0+/, "") || "0", scale = fraction.length - exponent;
		if (digits.length > this.maxExactDigits || !Number.isSafeInteger(exponent) || Math.abs(exponent) > this.maxExactScale || Math.abs(scale) > this.maxExactScale) return null;
		let num = BigInt(digits);
		if (match[1] === "-") num = -num;
		return scale >= 0 ? this.rational(num, 10n ** BigInt(scale)) : this.rational(num * 10n ** BigInt(-scale), 1n);
	}
	multiply(left: {
		num: bigint;
		den: bigint;
	}, right: {
		num: bigint;
		den: bigint;
	}) {
		return this.rational(left.num * right.num, left.den * right.den);
	}
	subtract(left: {
		num: bigint;
		den: bigint;
	}, right: {
		num: bigint;
		den: bigint;
	}) {
		return this.rational(left.num * right.den - right.num * left.den, left.den * right.den);
	}
	formatRational(value: {
		num: bigint;
		den: bigint;
	}) {
		if (value.num === 0n) return "0";
		if (value.den === 1n) return value.num.toString();
		let denominator = value.den, twos = 0, fives = 0;
		while (denominator % 2n === 0n) {
			denominator /= 2n;
			twos += 1;
		}
		while (denominator % 5n === 0n) {
			denominator /= 5n;
			fives += 1;
		}
		const places = Math.max(twos, fives);
		if (denominator === 1n && places <= 12) {
			const scaled = value.num * 2n ** BigInt(places - twos) * 5n ** BigInt(places - fives), negative = scaled < 0n;
			const digits = (negative ? -scaled : scaled).toString().padStart(places + 1, "0");
			const whole = places ? digits.slice(0, -places) : digits, fraction = places ? digits.slice(-places).replace(/0+$/, "") : "";
			return `${negative ? "−" : ""}${whole}${fraction ? `.${fraction}` : ""}`;
		}
		const approximate = Number(value.num) / Number(value.den);
		return Number.isFinite(approximate) && approximate !== 0 ? `${value.num}/${value.den} (≈ ${approximate.toExponential(5)})` : `${value.num}/${value.den}`;
	}
	formatNumber(value: number) {
		if (!Number.isFinite(value)) return "outside browser numeric range";
		if (value !== 0 && (Math.abs(value) < .001 || Math.abs(value) >= 1e5)) return value.toExponential(5);
		return Number(value.toPrecision(6)).toString();
	}
	draw() {
		const exactKeys = [
			"a",
			"b",
			"c",
			"d"
		], exactValues = exactKeys.map((key) => this.decimal(this.raw(key)));
		exactKeys.forEach((key, index) => this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.setAttribute("aria-invalid", String(exactValues[index] === null)));
		if (exactValues.some((value) => value === null)) {
			const summary = this.querySelector<HTMLElement>("[data-summary]")!, svg = this.querySelector("svg")!;
			summary.innerHTML = `<strong>Exact input not accepted.</strong><br>Use a valid decimal or scientific-notation value with at most ${this.maxExactDigits} significant digits, with the written exponent and decimal scale between −${this.maxExactScale} and ${this.maxExactScale}. The model will classify the vectors after all four candidate-vector components are back within this range.`;
			svg.innerHTML = "";
			svg.setAttribute("aria-label", "The candidate-vector input is outside the exact arithmetic limit, so no basis classification is shown.");
			return;
		}
		const v1 = {
			x: this.get("a"),
			y: this.get("b")
		}, v2 = {
			x: this.get("c"),
			y: this.get("d")
		}, target = {
			x: this.get("x"),
			y: this.get("y")
		};
		const [exactA, exactB, exactC, exactD] = exactValues as {
			num: bigint;
			den: bigint;
		}[];
		const exactDet = this.subtract(this.multiply(exactA, exactD), this.multiply(exactC, exactB));
		const det = v1.x * v2.y - v2.x * v1.y, independent = exactDet.num !== 0n, numericUsable = independent && det !== 0 && Number.isFinite(det);
		const alpha = numericUsable ? (target.x * v2.y - v2.x * target.y) / det : 0, beta = numericUsable ? (v1.x * target.y - target.x * v1.y) / det : 0;
		const frobeniusSquared = v1.x * v1.x + v1.y * v1.y + v2.x * v2.x + v2.y * v2.y;
		const condition = independent ? frobeniusSquared / Math.abs(det) : Number.POSITIVE_INFINITY;
		const poorlyConditioned = independent && (!Number.isFinite(condition) || condition >= 1e6);
		const max = Math.max(3, Math.abs(v1.x), Math.abs(v1.y), Math.abs(v2.x), Math.abs(v2.y), Math.abs(target.x), Math.abs(target.y)) * 1.3;
		const cx = 220, cy = 170, s = 140 / max, pt = (q: {
			x: number;
			y: number;
		}) => ({
			x: cx + q.x * s,
			y: cy - q.y * s
		});
		const line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		const arrow = (q: {
			x: number;
			y: number;
		}, color: string, label: string) => {
			const e = pt(q);
			return `${line({
				x: cx,
				y: cy
			}, e, color, 4)}<circle cx="${e.x}" cy="${e.y}" r="5" fill="${color}"/><text x="${e.x + 7}" y="${e.y - 7}" fill="${color}" font-weight="700">${label}</text>`;
		};
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70") + arrow(v1, "#8f164d", "v₁") + arrow(v2, "#147d79", "v₂") + arrow(target, "#945508", "x");
		if (numericUsable) {
			const p1 = {
				x: alpha * v1.x,
				y: alpha * v1.y
			};
			drawing += line(pt(p1), pt(target), "#147d79", 3, "6 4") + line({
				x: cx,
				y: cy
			}, pt(p1), "#8f164d", 3, "6 4");
		} else if (!independent) {
			const n = Math.hypot(v1.x, v1.y) > 0 ? v1 : v2, nn = Math.hypot(n.x, n.y);
			if (nn > 0) drawing += line(pt({
				x: -n.x * max / nn,
				y: -n.y * max / nn
			}), pt({
				x: n.x * max / nn,
				y: n.y * max / nn
			}), "#8f164d", 3, "7 5");
		}
		const svg = this.querySelector("svg")!;
		svg.innerHTML = drawing;
		const summary = this.querySelector<HTMLElement>("[data-summary]")!;
		const determinantDisplay = this.formatRational(exactDet);
		if (independent && numericUsable) {
			const conditioning = poorlyConditioned ? `<br><em>Numerical state:</em> exactly independent but poorly conditioned (κ<sub>F</sub> ≈ ${this.formatNumber(condition)} ≥ 10<sup>6</sup>); small input changes can cause large coordinate changes.` : `<br><em>Numerical state:</em> not flagged as poorly conditioned (κ<sub>F</sub> ≈ ${this.formatNumber(condition)} &lt; 10<sup>6</sup>).`;
			summary.innerHTML = `<strong>Exact det[v₁ v₂] = ${determinantDisplay} ≠ 0</strong><br>The list is exactly independent, spans ℝ², and is a basis. [x]ᵦ = (${this.formatNumber(alpha)}, ${this.formatNumber(beta)}); these coordinates are unique.${conditioning}`;
			svg.setAttribute("aria-label", `Two exactly independent basis vectors, a target vector, and its unique coordinates. Exact determinant ${determinantDisplay}. ${poorlyConditioned ? "The basis is numerically poorly conditioned." : "The basis is not flagged as poorly conditioned."}`);
		} else if (independent) {
			summary.innerHTML = `<strong>Exact det[v₁ v₂] = ${determinantDisplay} ≠ 0</strong><br>The vectors are exactly independent and form a basis, but coordinate recovery is outside browser floating-point range. No approximate coordinate claim is shown.`;
			svg.setAttribute("aria-label", `Two exactly independent vectors with exact determinant ${determinantDisplay}; approximate coordinates are suppressed because they are outside browser floating-point range.`);
		} else summary.innerHTML = `<strong>det[v₁ v₂] = 0</strong><br>The vectors are dependent and span at most a line, so they are not a basis of ℝ². A target off that line has no coordinates; one on it has non-unique coefficients.`;
		if (!independent) svg.setAttribute("aria-label", "Two exactly dependent vectors spanning at most one line, together with a target vector.");
	}
}
if (!customElements.get("basis-lab")) customElements.define("basis-lab", BasisLab);