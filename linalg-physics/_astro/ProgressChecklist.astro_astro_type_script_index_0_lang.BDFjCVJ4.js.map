class CourseProgress extends HTMLElement {
	quizCompletionHandler?: (event: Event) => void;
	labCompletionHandler?: (event: Event) => void;
	connectedCallback() {
		const lecture = this.dataset.lecture;
		const key = `linalg-progress-${lecture}`;
		let stored: string[] = [];
		try {
			stored = JSON.parse(localStorage.getItem(key) || "[]");
		} catch {
			stored = [];
		}
		const boxes = [...this.querySelectorAll<HTMLInputElement>("input[type=\"checkbox\"]")];
		const quizBox = boxes.find((box) => box.value === "quiz");
		const labBox = boxes.find((box) => box.value === "lab");
		const labIds: string[] = JSON.parse(this.dataset.labs || "[]");
		if (quizBox) {
			try {
				if (localStorage.getItem(`linalg-quiz-${lecture}`) && !stored.includes("quiz")) stored.push("quiz");
			} catch {}
		}
		if (labBox && labIds.length) {
			try {
				const completedLabs: string[] = JSON.parse(localStorage.getItem(`linalg-labs-${lecture}`) || "[]");
				if (labIds.every((id) => completedLabs.includes(id)) && !stored.includes("lab")) stored.push("lab");
			} catch {}
		}
		const count = this.querySelector<HTMLElement>("[data-progress-count]");
		const bar = this.querySelector<HTMLElement>("[data-progress-bar]");
		const persist = () => {
			const selected = boxes.filter((item) => item.checked).map((item) => item.value);
			try {
				localStorage.setItem(key, JSON.stringify(selected));
			} catch {}
		};
		const update = () => {
			const complete = boxes.filter((item) => item.checked).length;
			if (count) count.textContent = `${complete}/${boxes.length}`;
			if (bar) bar.style.width = `${complete / boxes.length * 100}%`;
		};
		boxes.forEach((box) => {
			box.checked = stored.includes(box.value);
			box.addEventListener("change", () => {
				persist();
				update();
			});
		});
		this.quizCompletionHandler = (event) => {
			const completedLecture = (event as CustomEvent<{
				lecture?: string;
			}>).detail?.lecture;
			if (!quizBox || completedLecture !== lecture) return;
			quizBox.checked = true;
			persist();
			update();
		};
		window.addEventListener("linalg-quiz-complete", this.quizCompletionHandler);
		this.labCompletionHandler = (event) => {
			const completedLecture = (event as CustomEvent<{
				lecture?: string;
			}>).detail?.lecture;
			if (!labBox || completedLecture !== lecture) return;
			try {
				const completedLabs: string[] = JSON.parse(localStorage.getItem(`linalg-labs-${lecture}`) || "[]");
				if (!labIds.every((id) => completedLabs.includes(id))) return;
			} catch {
				return;
			}
			labBox.checked = true;
			persist();
			update();
		};
		window.addEventListener("linalg-lab-complete", this.labCompletionHandler);
		persist();
		update();
	}
	disconnectedCallback() {
		if (this.quizCompletionHandler) window.removeEventListener("linalg-quiz-complete", this.quizCompletionHandler);
		if (this.labCompletionHandler) window.removeEventListener("linalg-lab-complete", this.labCompletionHandler);
	}
}
if (!customElements.get("course-progress")) customElements.define("course-progress", CourseProgress);