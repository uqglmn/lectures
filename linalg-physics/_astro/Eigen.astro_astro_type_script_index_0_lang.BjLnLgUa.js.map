class EigenLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const a = this.get("a"), b = this.get("b"), c = this.get("c"), d = this.get("d"), trace = a + d, det = a * d - b * c, disc = trace * trace - 4 * det;
		const scalar = Math.abs(b) < 1e-9 && Math.abs(c) < 1e-9 && Math.abs(a - d) < 1e-9;
		const cx = 220, cy = 170, base = 58, outputScale = 58 / Math.max(1, Math.hypot(a, c), Math.hypot(b, d));
		const point = (x: number, y: number, s = base) => ({
			x: cx + x * s,
			y: cy - y * s
		}), line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70") + `<circle cx="${cx}" cy="${cy}" r="${base}" fill="none" stroke="#147d79" stroke-width="2" stroke-dasharray="5 4"/>`;
		const transformed = [];
		for (let i = 0; i <= 80; i++) {
			const angle = 2 * Math.PI * i / 80, x = Math.cos(angle), y = Math.sin(angle);
			transformed.push(point(a * x + b * y, c * x + d * y, outputScale));
		}
		drawing += `<path d="${transformed.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(" ")}" fill="rgb(143 22 77 / .08)" stroke="#8f164d" stroke-width="4"/>`;
		const directions: {
			x: number;
			y: number;
			label: string;
		}[] = [];
		if (disc >= -1e-9 && !scalar) {
			const root = Math.sqrt(Math.max(0, disc)), values = Math.abs(root) < 1e-8 ? [trace / 2] : [(trace + root) / 2, (trace - root) / 2];
			values.forEach((lambda, index) => {
				let v = Math.hypot(b, lambda - a) > 1e-8 ? {
					x: b,
					y: lambda - a
				} : {
					x: lambda - d,
					y: c
				};
				let n = Math.hypot(v.x, v.y);
				if (n < 1e-8) v = {
					x: 1,
					y: 0
				}, n = 1;
				directions.push({
					x: v.x / n,
					y: v.y / n,
					label: `λ${index + 1}`
				});
			});
		}
		directions.forEach((v, index) => {
			drawing += line(point(-2.35 * v.x, -2.35 * v.y), point(2.35 * v.x, 2.35 * v.y), index ? "#945508" : "#23724a", 4, index ? "7 4" : "") + `<text x="${point(2.1 * v.x, 2.1 * v.y).x}" y="${point(2.1 * v.x, 2.1 * v.y).y}" fill="${index ? "#945508" : "#23724a"}" font-weight="700">${v.label}</text>`;
		});
		if (scalar) drawing += `<circle cx="${cx}" cy="${cy}" r="138" fill="rgb(20 125 121 / .07)" stroke="#147d79" stroke-width="3" stroke-dasharray="7 5"/><text x="${cx}" y="38" text-anchor="middle" fill="#147d79" font-weight="700">every direction is invariant</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		const summary = this.querySelector<HTMLElement>("[data-summary]")!;
		if (scalar) summary.innerHTML = `<strong>A = ${a.toFixed(3)}I · χ(λ)=(λ−${a.toFixed(3)})²</strong><br>The sole eigenvalue is repeated, but its eigenspace is all of ℝ²: every non-zero vector is an eigenvector. Repetition alone does not prevent diagonalization.`;
		else if (disc >= -1e-9) {
			const root = Math.sqrt(Math.max(0, disc)), l1 = (trace + root) / 2, l2 = (trace - root) / 2;
			summary.innerHTML = `<strong>χ(λ)=λ²−${trace.toFixed(2)}λ+${det.toFixed(2)}</strong><br>Eigenvalues: ${l1.toFixed(3)}${Math.abs(l1 - l2) < 1e-8 ? " (repeated)" : ` and ${l2.toFixed(3)}`}. Along each drawn direction, A changes scale but not direction.`;
		} else {
			const real = trace / 2, imag = Math.sqrt(-disc) / 2;
			summary.innerHTML = `<strong>χ has negative discriminant ${disc.toFixed(3)}</strong><br>No real eigendirection exists. Over ℂ the eigenvalues are ${real.toFixed(3)} ± ${imag.toFixed(3)}i—this is why the scalar field matters.`;
		}
	}
}
if (!customElements.get("eigen-lab")) customElements.define("eigen-lab", EigenLab);