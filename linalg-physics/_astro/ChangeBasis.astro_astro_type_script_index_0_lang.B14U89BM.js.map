		const P: ExactMatrix = [[one, exactS], [zero, exactT]], Pinv: ExactMatrix = [[one, this.negate(this.divide(exactS, exactT))], [zero, this.divide(one, exactT)]], C = this.exactMatrixProduct(this.exactMatrixProduct(Pinv, A), P);
		const exactVector: ExactVector = [exactX, exactY], coordinates = this.exactMatrixVector(Pinv, exactVector), reconstruction = this.exactMatrixVector(P, coordinates), AxExact = this.exactMatrixVector(A, exactVector);
