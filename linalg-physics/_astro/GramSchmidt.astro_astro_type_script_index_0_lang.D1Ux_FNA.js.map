class GramSchmidtLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const v1 = {
			x: this.get("x1"),
			y: this.get("y1")
		}, v2 = {
			x: this.get("x2"),
			y: this.get("y2")
		};
		const step = Number(this.querySelector<HTMLInputElement>("[data-step]")?.value || 3);
		const n1 = Math.hypot(v1.x, v1.y);
		const e1 = n1 > 1e-9 ? {
			x: v1.x / n1,
			y: v1.y / n1
		} : {
			x: 0,
			y: 0
		};
		const coefficient = e1.x * v2.x + e1.y * v2.y;
		const projection = {
			x: coefficient * e1.x,
			y: coefficient * e1.y
		};
		const residual = {
			x: v2.x - projection.x,
			y: v2.y - projection.y
		};
		const nr = Math.hypot(residual.x, residual.y);
		const e2 = nr > 1e-9 ? {
			x: residual.x / nr,
			y: residual.y / nr
		} : {
			x: 0,
			y: 0
		};
		const max = Math.max(3, Math.abs(v1.x), Math.abs(v1.y), Math.abs(v2.x), Math.abs(v2.y)) * 1.25;
		const cx = 220, cy = 170, s = 140 / max;
		const pt = (v: {
			x: number;
			y: number;
		}) => ({
			x: cx + v.x * s,
			y: cy - v.y * s
		});
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			const p = i * max / 4;
			drawing += `<line x1="${pt({
				x: p,
				y: 0
			}).x}" y1="25" x2="${pt({
				x: p,
				y: 0
			}).x}" y2="315" stroke="#ece7e9"/><line x1="70" y1="${pt({
				x: 0,
				y: p
			}).y}" x2="370" y2="${pt({
				x: 0,
				y: p
			}).y}" stroke="#ece7e9"/>`;
		}
		drawing += `<line x1="65" y1="${cy}" x2="375" y2="${cy}" stroke="#746a70"/><line x1="${cx}" y1="320" x2="${cx}" y2="20" stroke="#746a70"/>`;
		const arrow = (v: {
			x: number;
			y: number;
		}, color: string, label: string, dash = "") => {
			const p = pt(v);
			return `<line x1="${cx}" y1="${cy}" x2="${p.x}" y2="${p.y}" stroke="${color}" stroke-width="4" ${dash ? `stroke-dasharray="${dash}"` : ""}/><circle cx="${p.x}" cy="${p.y}" r="5" fill="${color}"/><text x="${p.x + 7}" y="${p.y - 7}" fill="${color}" font-weight="700">${label}</text>`;
		};
		drawing += arrow(v1, "#64113f", "v₁") + arrow(v2, "#175b68", "v₂");
		if (step >= 2) {
			drawing += arrow(projection, "#bf6d19", "proj", "6 4");
			const a = pt(projection), b = pt(v2);
			drawing += `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="#175b68" stroke-width="4"/><text x="${(a.x + b.x) / 2 + 7}" y="${(a.y + b.y) / 2}" fill="#175b68" font-weight="700">u₂</text>`;
		}
		if (step >= 3) {
			drawing += arrow({
				x: e1.x * 1.25,
				y: e1.y * 1.25
			}, "#64113f", "e₁") + arrow({
				x: e2.x * 1.25,
				y: e2.y * 1.25
			}, "#23724a", "e₂");
		}
		this.querySelector("svg")!.innerHTML = drawing;
		const labels = [
			"",
			"1 · normuojame pirmą vektorių",
			"2 · atimame projekciją",
			"3 · ortonormuota bazė"
		];
		this.querySelector<HTMLOutputElement>("[data-step-label]")!.textContent = labels[step];
		const summary = this.querySelector<HTMLElement>("[data-summary]")!;
		if (n1 < 1e-9) summary.innerHTML = "<strong>v₁ negali būti nulinis.</strong> Pasirinkite nenulinį pirmą vektorių.";
		else if (nr < 1e-9) summary.innerHTML = "<strong>Vektoriai tiesiškai priklausomi.</strong> Antroji ortogonali kryptis neišlieka.";
		else summary.innerHTML = `<strong>e₁ = (${e1.x.toFixed(3)}, ${e1.y.toFixed(3)})</strong><br>u₂ = (${residual.x.toFixed(3)}, ${residual.y.toFixed(3)}); e₂ = (${e2.x.toFixed(3)}, ${e2.y.toFixed(3)}).<br>e₁·e₂ = ${(e1.x * e2.x + e1.y * e2.y).toFixed(3)}.`;
	}
}
if (!customElements.get("gram-schmidt-lab")) customElements.define("gram-schmidt-lab", GramSchmidtLab);