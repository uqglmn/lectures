class OperatorClassifierLab extends HTMLElement {
	connectedCallback() {
		this.querySelector("select")?.addEventListener("input", () => this.draw());
		this.draw();
	}
	draw() {
		const examples = {
			hermitian: {
				matrix: "[1  i; −i  2]",
				adjoint: "A† = A",
				self: true,
				unitary: false,
				normal: true,
				eigen: [[.382, 0], [2.618, 0]],
				note: "Self-adjoint operators represent observables: every eigenvalue is real and eigendirections for different eigenvalues are orthogonal."
			},
			swap: {
				matrix: "[0  1; 1  0]",
				adjoint: "A† = A = A⁻¹",
				self: true,
				unitary: true,
				normal: true,
				eigen: [[-1, 0], [1, 0]],
				note: "The swap is simultaneously an observable and a symmetry. Its real eigenvalues also lie on the unit circle."
			},
			phase: {
				matrix: "[i  0; 0  −i]",
				adjoint: "A† = A⁻¹ = −A",
				self: false,
				unitary: true,
				normal: true,
				eigen: [[0, 1], [0, -1]],
				note: "A unitary preserves every inner product. Its eigenvalues are phases on the unit circle, but need not be real."
			},
			normal: {
				matrix: "[2  0; 0  i]",
				adjoint: "A† = [2  0; 0  −i]",
				self: false,
				unitary: false,
				normal: true,
				eigen: [[2, 0], [0, 1]],
				note: "Diagonal operators are normal. This one is neither self-adjoint nor unitary, showing that normal is the broader spectral-theorem class."
			},
			shear: {
				matrix: "[1  1; 0  1]",
				adjoint: "A† = [1  0; 1  1]",
				self: false,
				unitary: false,
				normal: false,
				eigen: [[1, 0], [1, 0]],
				note: "The shear does not commute with its adjoint. Its repeated eigenvalue has only one eigendirection, so orthogonal diagonalization fails."
			}
		} as const;
		const key = this.querySelector<HTMLSelectElement>("[data-example]")?.value as keyof typeof examples || "hermitian", item = examples[key];
		const checks = [
			[
				"Self-adjoint",
				item.self,
				"A† = A"
			],
			[
				"Unitary",
				item.unitary,
				"A†A = I"
			],
			[
				"Normal",
				item.normal,
				"A†A = AA†"
			]
		];
		this.querySelector<HTMLElement>("[data-checks]")!.innerHTML = checks.map(([label, pass, test]) => `<div class="operator-check ${pass ? "pass" : "fail"}"><span>${pass ? "✓" : "×"}</span><div><strong>${label}</strong><small>${test}</small></div></div>`).join("");
		const cx = 220, cy = 170, s = 88, line = (x1: number, y1: number, x2: number, y2: number, color: string, width = 2, dash = "") => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (let i = -2; i <= 2; i++) drawing += line(cx + i * s / 2, 35, cx + i * s / 2, 305, "#ece7e9") + line(75, cy + i * s / 2, 365, cy + i * s / 2, "#ece7e9");
		drawing += line(65, cy, 375, cy, "#746a70") + line(cx, 315, cx, 25, "#746a70") + `<circle cx="${cx}" cy="${cy}" r="${s}" fill="none" stroke="#147d79" stroke-width="3" stroke-dasharray="7 5"/><text x="340" y="158" fill="#147d79">unit circle</text><text x="365" y="190" fill="#626b7c">Re</text><text x="230" y="30" fill="#626b7c">Im</text>`;
		item.eigen.forEach((z, index) => {
			const x = cx + z[0] * s, y = cy - z[1] * s;
			drawing += `<circle cx="${x}" cy="${y}" r="7" fill="${index ? "#945508" : "#8f164d"}"/><text x="${x + 9}" y="${y - 9}" fill="${index ? "#945508" : "#8f164d"}" font-weight="700">λ${index + 1}</text>`;
		});
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>A = ${item.matrix}</strong><br>${item.adjoint}. ${item.note}`;
	}
}
if (!customElements.get("operator-classifier-lab")) customElements.define("operator-classifier-lab", OperatorClassifierLab);