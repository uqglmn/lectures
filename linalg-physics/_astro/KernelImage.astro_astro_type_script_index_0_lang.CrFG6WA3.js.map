		const exactOutX = this.add(this.multiply(ea, ex), this.multiply(eb, ey)), exactOutY = this.add(this.multiply(ec, ex), this.multiply(ed, ey));
		const out = {
			x: a * x + b * y,
			y: c * x + d * y
		}, left = {
			cx: 155,
			cy: 170
		}, right = {
			cx: 465,
			cy: 170
		};
		const leftScale = 130 / Math.max(2.5, Math.abs(x), Math.abs(y)), rightScale = 130 / Math.max(2.5, Math.abs(out.x), Math.abs(out.y));
		const line = (x1: number, y1: number, x2: number, y2: number, color: string, width = 1, dash = "") => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (const panel of [left, right]) {
			for (let i = -3; i <= 3; i++) {
				const step = 48;
				drawing += line(panel.cx + i * step, panel.cy - 145, panel.cx + i * step, panel.cy + 145, "#ece7e9") + line(panel.cx - 140, panel.cy + i * step, panel.cx + 140, panel.cy + i * step, "#ece7e9");
			}
			drawing += line(panel.cx - 145, panel.cy, panel.cx + 145, panel.cy, "#746a70", 1.5) + line(panel.cx, panel.cy - 150, panel.cx, panel.cy + 150, "#746a70", 1.5);
		}
		const arrow = (panel: {
			cx: number;
			cy: number;
		}, vx: number, vy: number, scale: number, color: string, label: string) => `${line(panel.cx, panel.cy, panel.cx + vx * scale, panel.cy - vy * scale, color, 4)}<circle cx="${panel.cx + vx * scale}" cy="${panel.cy - vy * scale}" r="5" fill="${color}"/><text x="${panel.cx + vx * scale + 7}" y="${panel.cy - vy * scale - 7}" fill="${color}" font-weight="700">${label}</text>`;
		drawing += arrow(left, x, y, leftScale, "#64113f", "v") + arrow(right, out.x, out.y, rightScale, "#64113f", "Av");
		if (rank === 1) {
			const firstRowNonzero = ea.num !== 0n || eb.num !== 0n, k = firstRowNonzero ? {
				x: -b,
				y: a
			} : {
				x: -d,
				y: c
			}, kn = Math.hypot(k.x, k.y), kx = k.x / kn, ky = k.y / kn;
			drawing += line(left.cx - kx * 135, left.cy + ky * 135, left.cx + kx * 135, left.cy - ky * 135, "#175b68", 4, "7 5");
			const firstColumnNonzero = ea.num !== 0n || ec.num !== 0n, im = firstColumnNonzero ? {
				x: a,
				y: c
			} : {
				x: b,
				y: d
			}, imn = Math.hypot(im.x, im.y), ix = im.x / imn, iy = im.y / imn;
			drawing += line(right.cx - ix * 135, right.cy + iy * 135, right.cx + ix * 135, right.cy - iy * 135, "#bf6d19", 5);
		}
		svg.innerHTML = `<text x="155" y="18" text-anchor="middle" fill="#6c6068" font-weight="700">Domain V</text><text x="465" y="18" text-anchor="middle" fill="#6c6068" font-weight="700">Codomain W</text><path d="M292 160 L326 160" stroke="#64113f" stroke-width="2"/><path d="M326 160 l-9 -6 v12 z" fill="#64113f"/><text x="309" y="148" text-anchor="middle" fill="#64113f" font-weight="700">A</text>${drawing}`;
		const determinantDisplay = this.formatRational(exactDet), outDisplay = `(${this.formatRational(exactOutX)}, ${this.formatRational(exactOutY)})`;
		const frobeniusSquared = a * a + b * b + c * c + d * d, condition = rank === 2 ? frobeniusSquared / Math.abs(a * d - b * c) : Number.POSITIVE_INFINITY;
		const warning = rank === 2 && (!Number.isFinite(condition) || condition >= 1e6) ? `<br><em>Numerical state:</em> exactly invertible but poorly conditioned (κ<sub>F</sub> ≈ ${this.formatNumber(condition)}); this does not change the exact rank.` : rank === 2 ? `<br><em>Numerical state:</em> not flagged as poorly conditioned (κ<sub>F</sub> ≈ ${this.formatNumber(condition)}).` : "<br><em>Numerical state:</em> exactly singular; conditioning is separate from the exact branch shown.";
		const detail = rank === 2 ? "The exact kernel is {0} and the exact image is ℝ²." : rank === 1 ? "A is nonzero and exactly singular: the dashed blue line is the kernel and the orange line is the image." : "A is exactly the zero map: the kernel is all of ℝ² and the image is {0}.";
