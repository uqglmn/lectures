class TensorProductLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	value(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0) * Math.PI / 180;
	}
	draw() {
		const family = this.querySelector<HTMLSelectElement>("[data-family]")?.value || "schmidt", theta = this.value("theta"), alpha = this.value("alpha"), beta = this.value("beta");
		let coefficients: number[];
		if (family === "schmidt") coefficients = [
			Math.cos(theta),
			0,
			0,
			Math.sin(theta)
		];
		else coefficients = [
			Math.cos(alpha) * Math.cos(beta),
			Math.cos(alpha) * Math.sin(beta),
			Math.sin(alpha) * Math.cos(beta),
			Math.sin(alpha) * Math.sin(beta)
		];
		const determinant = coefficients[0] * coefficients[3] - coefficients[1] * coefficients[2], concurrence = Math.min(1, 2 * Math.abs(determinant)), labels = [
			"|00⟩",
			"|01⟩",
			"|10⟩",
			"|11⟩"
		], max = Math.max(...coefficients.map(Math.abs), .001);
		this.querySelector<HTMLElement>("[data-grid]")!.innerHTML = coefficients.map((value, index) => `<div class="coefficient-cell"><span>${labels[index]}</span><div><i style="height:${Math.abs(value) / max * 100}%"></i></div><strong>${value.toFixed(3)}</strong></div>`).join("");
		this.querySelector<HTMLElement>("[data-product-controls]")!.hidden = family !== "product";
		this.querySelector<HTMLElement>("[data-theta-group]")!.hidden = family !== "schmidt";
		this.querySelector<HTMLOutputElement>("[data-out=theta]")!.textContent = `${Math.round(theta * 180 / Math.PI)}°`;
		const factorable = Math.abs(determinant) < 1e-8, probA0 = coefficients[0] ** 2 + coefficients[1] ** 2;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>det C = ${determinant.toFixed(3)} · concurrence = ${concurrence.toFixed(3)}</strong><br>${factorable ? "The coefficient matrix has rank one, so the state factors as a tensor product." : "The coefficient matrix has rank two, so no pair of single-qubit states can produce it: the state is entangled."} Measuring the first qubit gives 0 with probability ${probA0.toFixed(3)}.`;
	}
}
if (!customElements.get("tensor-product-lab")) customElements.define("tensor-product-lab", TensorProductLab);