class HilbertApproximationLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	draw() {
		const kind = this.querySelector<HTMLSelectElement>("[data-function]")?.value || "square", modes = Number(this.querySelector<HTMLInputElement>("[data-key=modes]")?.value || 1), samples = 220;
		const target = (x: number) => kind === "square" ? Math.sin(x) >= 0 ? 1 : -1 : x / Math.PI;
		const coefficient = (n: number) => kind === "square" ? n % 2 === 1 ? 4 / (Math.PI * n) : 0 : 2 * (n % 2 === 1 ? 1 : -1) / (Math.PI * n);
		const partial = (x: number) => {
			let sum = 0;
			for (let n = 1; n <= modes; n++) sum += coefficient(n) * Math.sin(n * x);
			return sum;
		};
		const targetNorm2 = kind === "square" ? 1 : 1 / 3;
		let captured = 0;
		for (let n = 1; n <= modes; n++) captured += coefficient(n) ** 2 / 2;
		const residual = Math.sqrt(Math.max(0, targetNorm2 - captured));
		const plot = (fn: (x: number) => number) => Array.from({ length: samples + 1 }, (_, i) => {
			const x = -Math.PI + 2 * Math.PI * i / samples, y = fn(x);
			return {
				x: 42 + i * (416 / samples),
				y: 170 - y * 105
			};
		});
		const path = (points: {
			x: number;
			y: number;
		}[]) => points.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(" ");
		let drawing = "";
		for (let i = 0; i <= 8; i++) drawing += `<line x1="${42 + i * 52}" y1="30" x2="${42 + i * 52}" y2="310" stroke="#ece7e9"/>`;
		for (let i = -2; i <= 2; i++) drawing += `<line x1="42" y1="${170 + i * 52.5}" x2="458" y2="${170 + i * 52.5}" stroke="#ece7e9"/>`;
		drawing += `<line x1="35" y1="170" x2="465" y2="170" stroke="#746a70"/><line x1="250" y1="315" x2="250" y2="25" stroke="#746a70"/><path d="${path(plot(target))}" fill="none" stroke="#626b7c" stroke-width="3" stroke-dasharray="7 5"/><path d="${path(plot(partial))}" fill="none" stroke="#8f164d" stroke-width="4"/><text x="42" y="327" fill="#626b7c">−π</text><text x="448" y="327" fill="#626b7c">π</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out]")!.textContent = String(modes);
		const percent = Math.min(100, captured / targetNorm2 * 100);
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>${percent.toFixed(1)}% of ‖f‖² captured · ‖f−Sₙ‖₂ = ${residual.toFixed(4)}</strong><br>Sₙ is the best approximation in the span of the first ${modes} sine modes. The partial sums are Cauchy in L²; completeness is what guarantees their limit remains in the Hilbert space.${kind === "square" ? " Pointwise overshoot near jumps does not prevent L² convergence." : ""}`;
	}
}
if (!customElements.get("hilbert-approximation-lab")) customElements.define("hilbert-approximation-lab", HilbertApproximationLab);