interface Question {
	id: string;
	type: "choice" | "numeric";
	prompt: string;
	options?: string[];
	answer: number;
	tolerance?: number;
	hint: string;
	explanation: string;
}
class SelfQuiz extends HTMLElement {
	questions: Question[] = [];
	current = 0;
	score = 0;
	checked = false;
	body!: HTMLElement;
	progress!: HTMLElement;
	connectedCallback() {
		this.questions = JSON.parse(this.dataset.questions || "[]");
		this.body = this.querySelector(".quiz-body") as HTMLElement;
		this.progress = this.querySelector(".quiz-progress span") as HTMLElement;
		this.render();
	}
	escape(value: string) {
		return value.replace(/[&<>'"]/g, (character) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			"'": "&#39;",
			"\"": "&quot;"
		})[character] || character);
	}
	render() {
		if (!this.questions.length) return;
		if (this.current >= this.questions.length) {
			const percent = Math.round(this.score / this.questions.length * 100);
			this.progress.style.width = "100%";
			this.body.innerHTML = `
          <div class="quiz-score">
            <p class="quiz-kicker">Savikontrolė baigta</p>
            <h3>${this.score} iš ${this.questions.length} · ${percent}%</h3>
            <p>${percent === 100 ? "Puiku — visos sąvokos atpažintos." : "Peržiūrėkite paaiškinimus ir pabandykite dar kartą."}</p>
            <button class="small-button" data-action="restart">Kartoti</button>
          </div>`;
			this.body.querySelector("[data-action=restart]")?.addEventListener("click", () => {
				this.current = 0;
				this.score = 0;
				this.checked = false;
				this.render();
			});
			localStorage.setItem(`linalg-quiz-${this.dataset.lecture}`, JSON.stringify({
				score: this.score,
				total: this.questions.length
			}));
			return;
		}
		const question = this.questions[this.current];
		this.checked = false;
		this.progress.style.width = `${this.current / this.questions.length * 100}%`;
		const answer = question.type === "choice" ? `<div class="quiz-options">${(question.options || []).map((option, index) => `
            <label class="quiz-option"><input type="radio" name="quiz-${this.dataset.lecture}" value="${index}" /> <span>${this.escape(option)}</span></label>`).join("")}</div>` : `<label class="control-group"><span>Jūsų atsakymas</span><input class="number-field" type="number" step="any" inputmode="decimal" data-numeric /></label>`;
		this.body.innerHTML = `
        <div class="quiz-kicker">${this.current + 1} klausimas iš ${this.questions.length}</div>
        <div class="quiz-question">${this.escape(question.prompt)}</div>
        ${answer}
        <div class="quiz-feedback"></div>
        <div class="quiz-actions">
          <button class="small-button" data-action="check">Tikrinti</button>
          <button class="small-button secondary" data-action="hint">Užuomina</button>
        </div>`;
		this.body.querySelector("[data-action=check]")?.addEventListener("click", () => this.check(question));
		this.body.querySelector("[data-action=hint]")?.addEventListener("click", () => this.hint(question));
	}
	selected(question: Question): number | null {
		if (question.type === "numeric") {
			const input = this.body.querySelector<HTMLInputElement>("[data-numeric]");
			return input && input.value !== "" ? Number(input.value) : null;
		}
		const input = this.body.querySelector<HTMLInputElement>("input[type=\"radio\"]:checked");
		return input ? Number(input.value) : null;
	}
	check(question: Question) {
		if (this.checked) return;
		const selected = this.selected(question);
		const feedback = this.body.querySelector(".quiz-feedback") as HTMLElement;
		if (selected === null || Number.isNaN(selected)) {
			feedback.className = "quiz-feedback incorrect";
			feedback.textContent = "Pirmiausia pasirinkite arba įrašykite atsakymą.";
			return;
		}
		const correct = question.type === "numeric" ? Math.abs(selected - question.answer) <= (question.tolerance ?? 0) : selected === question.answer;
		this.checked = true;
		if (correct) this.score += 1;
		feedback.className = `quiz-feedback ${correct ? "correct" : "incorrect"}`;
		feedback.textContent = `${correct ? "Teisingai. " : "Dar ne. "}${question.explanation}`;
		const actions = this.body.querySelector(".quiz-actions") as HTMLElement;
		actions.innerHTML = `<button class="small-button" data-action="next">${this.current + 1 === this.questions.length ? "Rezultatas" : "Kitas klausimas"}</button>`;
		actions.querySelector("button")?.addEventListener("click", () => {
			this.current += 1;
			this.render();
		});
	}
	hint(question: Question) {
		const feedback = this.body.querySelector(".quiz-feedback") as HTMLElement;
		feedback.className = "quiz-feedback";
		feedback.textContent = `Užuomina: ${question.hint}`;
	}
}
if (!customElements.get("self-quiz")) customElements.define("self-quiz", SelfQuiz);