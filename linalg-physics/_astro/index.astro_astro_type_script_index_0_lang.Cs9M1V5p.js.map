document.querySelectorAll<HTMLElement>("[data-phase-checkpoints] [data-phase]").forEach((card) => {
	try {
		const completed = localStorage.getItem(`linalg-phase-${card.dataset.phase}`);
		if (!completed) return;
		const badge = document.createElement("em");
		badge.className = "phase-complete";
		badge.textContent = `Completed ${new Intl.DateTimeFormat(undefined, {
			day: "numeric",
			month: "short"
		}).format(new Date(completed))}`;
		card.append(badge);
	} catch {}
});