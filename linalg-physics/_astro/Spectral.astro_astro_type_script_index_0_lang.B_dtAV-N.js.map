type Rational = {
	num: bigint;
	den: bigint;
};
class SpectralLab extends HTMLElement {
	readonly maxExactDigits = 24;
	readonly maxExactScale = 100;
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	raw(key: string) {
		return this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value ?? "";
	}
	get(key: string) {
		return Number(this.raw(key));
	}
	gcd(a: bigint, b: bigint) {
		a = a < 0n ? -a : a;
		b = b < 0n ? -b : b;
		while (b) {
			const r = a % b;
			a = b;
			b = r;
		}
		return a || 1n;
	}
	rational(num: bigint, den: bigint): Rational {
		if (den < 0n) {
			num = -num;
			den = -den;
		}
		const divisor = this.gcd(num, den);
		return {
			num: num / divisor,
			den: den / divisor
		};
	}
	decimal(value: string): Rational | null {
		const raw = value.trim();
		if (raw.length > 64) return null;
		const match = raw.match(/^([+-]?)(?:(\d+)(?:\.(\d*))?|\.(\d+))(?:[eE]([+-]?\d+))?$/);
		if (!match) return null;
		const fraction = match[3] ?? match[4] ?? "", integer = match[2] ?? "0", exponent = Number(match[5] || 0), digits = (integer + fraction).replace(/^0+/, "") || "0", scale = fraction.length - exponent;
		if (digits.length > this.maxExactDigits || !Number.isSafeInteger(exponent) || Math.abs(exponent) > this.maxExactScale || Math.abs(scale) > this.maxExactScale) return null;
		let num = BigInt(digits);
		if (match[1] === "-") num = -num;
		return scale >= 0 ? this.rational(num, 10n ** BigInt(scale)) : this.rational(num * 10n ** BigInt(-scale), 1n);
	}
	subtract(left: Rational, right: Rational) {
		return this.rational(left.num * right.den - right.num * left.den, left.den * right.den);
	}
	formatExact(value: Rational) {
		if (value.num === 0n) return "0";
		const negative = value.num < 0n;
		let denominator = value.den, twos = 0, fives = 0;
		while (denominator % 2n === 0n) {
			denominator /= 2n;
			twos++;
		}
		while (denominator % 5n === 0n) {
			denominator /= 5n;
			fives++;
		}
		if (denominator !== 1n) return `${value.num}/${value.den}`;
		const scale = Math.max(twos, fives);
		let scaled = (negative ? -value.num : value.num) * 2n ** BigInt(scale - twos) * 5n ** BigInt(scale - fives);
		let digits = scaled.toString().padStart(scale + 1, "0");
		const point = digits.length - scale, first = digits.search(/[1-9]/), exponent = point - first - 1;
		const significant = digits.slice(first).replace(/0+$/, "");
		if (exponent >= 12 || exponent <= -7) {
			const coefficient = significant.length === 1 ? significant : `${significant[0]}.${significant.slice(1)}`;
			return `${negative ? "-" : ""}${coefficient}e${exponent >= 0 ? "+" : ""}${exponent}`;
		}
		const integer = digits.slice(0, point), fraction = digits.slice(point).replace(/0+$/, "");
		return `${negative ? "-" : ""}${integer}${fraction ? `.` + fraction : ""}`;
	}
	format(value: number) {
		if (!Number.isFinite(value)) return "outside floating-point range";
		if (value !== 0 && (Math.abs(value) < .001 || Math.abs(value) >= 1e5)) return value.toExponential(5);
		return Number(value.toPrecision(6)).toString();
	}
	draw() {
		const keys = [
			"a",
			"b",
			"d"
		], exactValues = keys.map((key) => this.decimal(this.raw(key)));
		keys.forEach((key, index) => this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.setAttribute("aria-invalid", String(exactValues[index] === null)));
		const mirror = this.querySelector<HTMLInputElement>("[data-key=b2]");
		if (mirror) mirror.value = this.raw("b");
		const summary = this.querySelector<HTMLElement>("[data-summary]")!, svg = this.querySelector("svg")!;
		const angle = Number(this.querySelector<HTMLInputElement>("[data-angle]")?.value || 0);
		this.querySelector<HTMLOutputElement>("[data-angle-label]")!.textContent = `${angle}°`;
		if (exactValues.some((value) => value === null)) {
			summary.innerHTML = `<strong>Exact classification suppressed.</strong><br>Enter three valid decimals or scientific-notation values with at most ${this.maxExactDigits} significant digits and written exponent/scale between −${this.maxExactScale} and ${this.maxExactScale}. Blank, invalid, or larger inputs are not treated as zero.`;
			svg.innerHTML = "";
			svg.setAttribute("aria-label", "No spectral result is shown because at least one matrix entry is blank, invalid, or outside the exact arithmetic bounds.");
			return;
		}
		const [ea, eb, ed] = exactValues as Rational[], exactDifference = this.subtract(ea, ed), degenerate = exactDifference.num === 0n && eb.num === 0n;
		const a = this.get("a"), b = this.get("b"), d = this.get("d"), trace = a + d, delta = Math.hypot(a - d, 2 * b);
		const l1 = (trace + delta) / 2, l2 = (trace - delta) / 2;
		const numericUsable = [
			a,
			b,
			d,
			trace,
			delta,
			l1,
			l2
		].every(Number.isFinite);
		const theta = numericUsable ? .5 * Math.atan2(2 * b, a - d) : 0;
		const e1 = {
			x: Math.cos(theta),
			y: Math.sin(theta)
		};
		const e2 = {
			x: -e1.y,
			y: e1.x
		};
		const radians = angle * Math.PI / 180, psi = {
			x: Math.cos(radians),
			y: Math.sin(radians)
		};
		const amp1 = e1.x * psi.x + e1.y * psi.y, amp2 = e2.x * psi.x + e2.y * psi.y, p1 = amp1 * amp1, p2 = amp2 * amp2;
		const cx = 220, cy = 170, s = 115;
		const p = (v: {
			x: number;
			y: number;
		}, k = 1) => ({
			x: cx + v.x * s * k,
			y: cy - v.y * s * k
		});
		const line = (u: {
			x: number;
			y: number;
		}, v: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${u.x}" y1="${u.y}" x2="${v.x}" y2="${v.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = `<title>${degenerate ? `Exact degeneracy at eigenvalue ${this.formatExact(ea)}` : `Two exact distinct eigenvalues, approximately ${this.format(l1)} and ${this.format(l2)}`}</title>`;
		for (let i = -3; i <= 3; i++) {
			const q = cx + i * 46;
			drawing += `<line x1="${q}" y1="25" x2="${q}" y2="315" stroke="#ece7e9"/><line x1="75" y1="${cy + i * 46}" x2="365" y2="${cy + i * 46}" stroke="#ece7e9"/>`;
		}
		drawing += line({
			x: 65,
			y: cy
		}, {
			x: 375,
			y: cy
		}, "#746a70", 1) + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70", 1);
		if (numericUsable) drawing += line({
			x: cx,
			y: cy
		}, p(psi), "#bf6d19", 5) + `<circle cx="${p(psi).x}" cy="${p(psi).y}" r="6" fill="#bf6d19"/><text x="${p(psi).x + 8}" y="${p(psi).y - 8}" fill="#bf6d19" font-weight="700">ψ</text>`;
		if (degenerate && numericUsable) {
			drawing += `<circle cx="${cx}" cy="${cy}" r="132" fill="rgb(20 125 121 / .08)" stroke="#147d79" stroke-width="3" stroke-dasharray="7 6"/><text x="${cx}" y="34" text-anchor="middle" fill="#147d79" font-weight="700">every direction is an eigendirection</text>`;
		} else if (numericUsable) {
			drawing += line(p(e1, -1.35), p(e1, 1.35), "#64113f", 4) + line(p(e2, -1.35), p(e2, 1.35), "#175b68", 4);
			const pr1 = p(e1, amp1), pr2 = p(e2, amp2);
			drawing += line({
				x: cx,
				y: cy
			}, pr1, "#64113f", 7, "7 4") + line({
				x: cx,
				y: cy
			}, pr2, "#175b68", 7, "7 4");
			drawing += `<text x="${p(e1, 1.43).x}" y="${p(e1, 1.43).y}" fill="#64113f" font-weight="700">e₁</text><text x="${p(e2, 1.43).x}" y="${p(e2, 1.43).y}" fill="#175b68" font-weight="700">e₂</text>`;
		}
		svg.innerHTML = drawing;
		if (degenerate) {
			const exactEigen = this.formatExact(ea);
			summary.innerHTML = `<strong>Exact result: λ = ${exactEigen} is degenerate · P(λ) = 1.</strong><br>The exact projector is I. Every direction is an eigendirection, so splitting this one ideal-projective outcome by an arbitrary basis would be unphysical. Approximate drawing geometry is not used for classification.`;
			svg.setAttribute("aria-label", `Exact degenerate real-symmetric matrix with sole eigenvalue ${exactEigen}. Every direction is an eigendirection and the ideal-projective outcome has probability one.`);
		} else if (numericUsable) {
			const scale = Math.max(1, Math.abs(a), Math.abs(b), Math.abs(d), Math.abs(l1), Math.abs(l2)), near = delta < 1e-8 * scale, displayCoincides = this.format(l1) === this.format(l2);
			summary.innerHTML = `<strong>Exact result: two distinct eigenvalues.</strong><br>Approximate eigenvalues: λ₁ = ${this.format(l1)}, λ₂ = ${this.format(l2)}.${displayCoincides ? " Browser precision does not resolve their separation; the exact distinct classification remains authoritative." : ""}<br>Approximate eigendirections: e₁=(${this.format(e1.x)}, ${this.format(e1.y)}), e₂=(${this.format(e2.x)}, ${this.format(e2.y)}).<br>P(λ₁) = |⟨e₁,ψ⟩|² ≈ ${this.format(p1)} · P(λ₂) ≈ ${this.format(p2)}.<br><em>Numerical state:</em> ${near ? "near-degenerate/poorly separated at drawing scale, but not exactly degenerate" : "well separated at drawing scale"}.`;
			svg.setAttribute("aria-label", `Two exact distinct eigenvalues, approximately ${this.format(l1)} and ${this.format(l2)}. Approximate eigendirections ${this.format(e1.x)}, ${this.format(e1.y)} and ${this.format(e2.x)}, ${this.format(e2.y)}. Born probabilities approximately ${this.format(p1)} and ${this.format(p2)}. ${near ? "Numerically near-degenerate, but exactly distinct." : "Numerically well separated."}`);
		} else {
			summary.innerHTML = "<strong>Exact result: two distinct eigenvalues.</strong><br>Approximate eigenvalues, eigendirections, probabilities, and drawing are suppressed because the values are outside browser floating-point range.";
			svg.innerHTML = "";
			svg.setAttribute("aria-label", "The accepted exact matrix has two distinct eigenvalues, but approximate spectral geometry is suppressed because it is outside floating-point range.");
		}
	}
}
if (!customElements.get("spectral-lab")) customElements.define("spectral-lab", SpectralLab);