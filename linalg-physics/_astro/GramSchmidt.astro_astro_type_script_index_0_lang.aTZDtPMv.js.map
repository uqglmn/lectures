class GramSchmidtLab extends HTMLElement {
	readonly maxExactDigits = 24;
	readonly maxExactScale = 100;
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	raw(key: string) {
		return this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value ?? "";
	}
	get(key: string) {
		return Number(this.raw(key));
	}
	gcd(a: bigint, b: bigint) {
		a = a < 0n ? -a : a;
		b = b < 0n ? -b : b;
		while (b) {
			const r = a % b;
			a = b;
			b = r;
		}
		return a || 1n;
	}
	rational(num: bigint, den: bigint) {
		if (den < 0n) {
			num = -num;
			den = -den;
		}
		const g = this.gcd(num, den);
		return {
			num: num / g,
			den: den / g
		};
	}
	decimal(value: string) {
		const raw = value.trim();
		if (raw.length > 64) return null;
		const match = raw.match(/^([+-]?)(?:(\d+)(?:\.(\d*))?|\.(\d+))(?:[eE]([+-]?\d+))?$/);
		if (!match) return null;
		const fraction = match[3] ?? match[4] ?? "", integer = match[2] ?? "0", exponent = Number(match[5] || 0), digits = (integer + fraction).replace(/^0+/, "") || "0", scale = fraction.length - exponent;
		if (digits.length > this.maxExactDigits || !Number.isSafeInteger(exponent) || Math.abs(exponent) > this.maxExactScale || Math.abs(scale) > this.maxExactScale) return null;
		let num = BigInt(digits);
		if (match[1] === "-") num = -num;
		return scale >= 0 ? this.rational(num, 10n ** BigInt(scale)) : this.rational(num * 10n ** BigInt(-scale), 1n);
	}
	multiply(a: {
		num: bigint;
		den: bigint;
	}, b: {
		num: bigint;
		den: bigint;
	}) {
		return this.rational(a.num * b.num, a.den * b.den);
	}
	subtract(a: {
		num: bigint;
		den: bigint;
	}, b: {
		num: bigint;
		den: bigint;
	}) {
		return this.rational(a.num * b.den - b.num * a.den, a.den * b.den);
	}
	formatExact(value: {
		num: bigint;
		den: bigint;
	}) {
		if (value.num === 0n) return "0";
		const approx = Number(value.num) / Number(value.den);
		if (Number.isFinite(approx) && approx !== 0) return Math.abs(approx) < .001 || Math.abs(approx) >= 1e5 ? approx.toExponential(5) : Number(approx.toPrecision(6)).toString();
		return `${value.num}/${value.den}`;
	}
	format(value: number) {
		if (!Number.isFinite(value)) return "outside floating-point range";
		if (value !== 0 && (Math.abs(value) < .001 || Math.abs(value) >= 1e5)) return value.toExponential(5);
		return Number(value.toPrecision(6)).toString();
	}
	draw() {
		const step = Number(this.querySelector<HTMLInputElement>("[data-step]")?.value || 3);
		const keys = [
			"x1",
			"y1",
			"x2",
			"y2"
		], values = keys.map((key) => this.decimal(this.raw(key)));
		keys.forEach((key, index) => this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.setAttribute("aria-invalid", String(values[index] === null)));
		const summary = this.querySelector<HTMLElement>("[data-summary]")!, svg = this.querySelector("svg")!;
		const labels = [
			"",
			"1 · normalise the first vector",
			"2 · subtract the projection",
			"3 · orthonormal basis"
		];
		this.querySelector<HTMLOutputElement>("[data-step-label]")!.textContent = labels[step];
		if (values.some((value) => value === null)) {
			summary.innerHTML = `<strong>Exact classification suppressed.</strong><br>Enter four valid decimals or scientific-notation values with at most ${this.maxExactDigits} significant digits and written exponent/scale between −${this.maxExactScale} and ${this.maxExactScale}. Blank, invalid, or larger inputs are not treated as zero.`;
			svg.innerHTML = "";
			svg.setAttribute("aria-label", "No Gram–Schmidt result is shown because at least one input is blank, invalid, or outside the exact arithmetic bounds.");
			return;
		}
		const [a, b, c, d] = values as {
			num: bigint;
			den: bigint;
		}[], zeroFirst = a.num === 0n && b.num === 0n, zeroSecond = c.num === 0n && d.num === 0n, det = this.subtract(this.multiply(a, d), this.multiply(b, c)), independent = det.num !== 0n;
		const v1 = {
			x: this.get("x1"),
			y: this.get("y1")
		}, v2 = {
			x: this.get("x2"),
			y: this.get("y2")
		};
		const n1 = Math.hypot(v1.x, v1.y);
		const numericFirst = !zeroFirst && Number.isFinite(n1) && n1 !== 0;
		const e1 = numericFirst ? {
			x: v1.x / n1,
			y: v1.y / n1
		} : {
			x: 0,
			y: 0
		};
		const coefficient = e1.x * v2.x + e1.y * v2.y;
		const projection = {
			x: coefficient * e1.x,
			y: coefficient * e1.y
		};
		const residual = {
			x: v2.x - projection.x,
			y: v2.y - projection.y
		};
		const detSign = det.num < 0n ? -1 : 1;
		const e2 = independent && numericFirst ? {
			x: detSign * (-v1.y / n1),
			y: detSign * (v1.x / n1)
		} : {
			x: 0,
			y: 0
		};
		const shownProjection = !independent && !zeroFirst ? v2 : projection, shownResidual = !independent ? {
			x: 0,
			y: 0
		} : residual;
		const numericUsable = [
			v1.x,
			v1.y,
			v2.x,
			v2.y,
			coefficient,
			projection.x,
			projection.y,
			residual.x,
			residual.y,
			e1.x,
			e1.y,
			e2.x,
			e2.y
		].every(Number.isFinite) && numericFirst;
		const n2 = Math.hypot(v2.x, v2.y), normalizedDet = numericFirst && Number.isFinite(n2) && n2 !== 0 ? Math.abs(v1.x * v2.y - v1.y * v2.x) / (n1 * n2) : Number.NaN, nearIndependent = independent && (!Number.isFinite(normalizedDet) || normalizedDet < 1e-8);
		const max = Math.max(3, Math.abs(v1.x), Math.abs(v1.y), Math.abs(v2.x), Math.abs(v2.y)) * 1.25;
		const cx = 220, cy = 170, s = 140 / max;
		const pt = (v: {
			x: number;
			y: number;
		}) => ({
			x: cx + v.x * s,
			y: cy - v.y * s
		});
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			const p = i * max / 4;
			drawing += `<line x1="${pt({
				x: p,
				y: 0
			}).x}" y1="25" x2="${pt({
				x: p,
				y: 0
			}).x}" y2="315" stroke="#ece7e9"/><line x1="70" y1="${pt({
				x: 0,
				y: p
			}).y}" x2="370" y2="${pt({
				x: 0,
				y: p
			}).y}" stroke="#ece7e9"/>`;
		}
		drawing += `<line x1="65" y1="${cy}" x2="375" y2="${cy}" stroke="#746a70"/><line x1="${cx}" y1="320" x2="${cx}" y2="20" stroke="#746a70"/>`;
		const arrow = (v: {
			x: number;
			y: number;
		}, color: string, label: string, dash = "") => {
			const p = pt(v);
			return `<line x1="${cx}" y1="${cy}" x2="${p.x}" y2="${p.y}" stroke="${color}" stroke-width="4" ${dash ? `stroke-dasharray="${dash}"` : ""}/><circle cx="${p.x}" cy="${p.y}" r="5" fill="${color}"/><text x="${p.x + 7}" y="${p.y - 7}" fill="${color}" font-weight="700">${label}</text>`;
		};
		if (numericUsable) {
			drawing += arrow(v1, "#64113f", "v₁") + arrow(v2, "#175b68", "v₂");
			if (step >= 2 && !zeroFirst) {
				drawing += arrow(shownProjection, "#bf6d19", "proj", "6 4");
				const p = pt(shownProjection), q = pt(v2);
				drawing += `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="#175b68" stroke-width="4"/><text x="${(p.x + q.x) / 2 + 7}" y="${(p.y + q.y) / 2}" fill="#175b68" font-weight="700">u₂</text>`;
			}
			if (step >= 3 && !zeroFirst) {
				drawing += arrow({
					x: e1.x * 1.25,
					y: e1.y * 1.25
				}, "#64113f", "e₁");
				if (independent) drawing += arrow({
					x: e2.x * 1.25,
					y: e2.y * 1.25
				}, "#23724a", "e₂");
			}
		} else drawing = "";
		svg.innerHTML = drawing;
		const detText = this.formatExact(det);
		if (zeroFirst) {
			summary.innerHTML = "<strong>Exact result: v₁ is the zero vector.</strong><br>Gram–Schmidt cannot normalise the first input. This is an exact branch, not a tolerance decision.";
			svg.setAttribute("aria-label", "Exact zero first vector; Gram–Schmidt stops before normalization.");
		} else if (!independent) {
			summary.innerHTML = `<strong>Exact result: det[v₁ v₂] = 0, so the pair is linearly dependent.</strong><br>${zeroSecond ? "The second input is exactly zero." : "The exact second residual is zero."} Approximate drawing values are not used for this classification.`;
			svg.setAttribute("aria-label", `Exactly dependent input pair with determinant zero; ${zeroSecond ? "the second vector is zero" : "the second Gram–Schmidt residual is zero"}.`);
		} else if (numericUsable) {
			summary.innerHTML = `<strong>Exact result: det[v₁ v₂] = ${detText} ≠ 0, so the pair is independent.</strong><br>Approximate display: e₁=(${this.format(e1.x)}, ${this.format(e1.y)}); u₂=(${this.format(shownResidual.x)}, ${this.format(shownResidual.y)}); e₂=(${this.format(e2.x)}, ${this.format(e2.y)}), with e₁·e₂≈${this.format(e1.x * e2.x + e1.y * e2.y)}.<br><em>Numerical state:</em> ${nearIndependent ? "near-dependent/poorly conditioned; exact independence is retained and the perpendicular direction is computed from the exact determinant sign" : "not flagged as near-dependent"}.`;
			svg.setAttribute("aria-label", `Exactly independent input pair with determinant ${detText}. Approximate orthonormal directions e1 ${this.format(e1.x)}, ${this.format(e1.y)} and e2 ${this.format(e2.x)}, ${this.format(e2.y)}. ${nearIndependent ? "Numerically near-dependent, but not exactly dependent." : "Not flagged as numerically near-dependent."}`);
		} else {
			summary.innerHTML = `<strong>Exact result: det[v₁ v₂] = ${detText} ≠ 0, so the pair is independent.</strong><br>Approximate lengths or drawing coordinates are outside browser floating-point range. No approximate residual, normalized vector, or diagram claim is shown.`;
			svg.setAttribute("aria-label", `Exactly independent input pair with determinant ${detText}; approximate drawing suppressed because it is outside floating-point range.`);
		}
	}
}
if (!customElements.get("gram-schmidt-lab")) customElements.define("gram-schmidt-lab", GramSchmidtLab);