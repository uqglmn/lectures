class InnerProductLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const ru = this.get("ru"), rv = this.get("rv"), angle = this.get("angle"), theta = angle * Math.PI / 180, u = {
			x: ru,
			y: 0
		}, v = {
			x: rv * Math.cos(theta),
			y: rv * Math.sin(theta)
		}, sum = {
			x: u.x + v.x,
			y: v.y
		}, projection = {
			x: rv * Math.cos(theta),
			y: 0
		};
		const inner = ru * rv * Math.cos(theta), sumNorm = Math.hypot(sum.x, sum.y), probability = Math.cos(theta) ** 2, cx = 150, cy = 235, scale = 95;
		const pt = (q: {
			x: number;
			y: number;
		}) => ({
			x: cx + q.x * scale,
			y: cy - q.y * scale
		}), line = (a: {
			x: number;
			y: number;
		}, b: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		const arrow = (q: {
			x: number;
			y: number;
		}, color: string, label: string) => {
			const e = pt(q);
			return `${line({
				x: cx,
				y: cy
			}, e, color, 5)}<circle cx="${e.x}" cy="${e.y}" r="5" fill="${color}"/><text x="${e.x + 8}" y="${e.y - 8}" fill="${color}" font-weight="700">${label}</text>`;
		};
		let drawing = "";
		for (let i = -1; i <= 3; i++) drawing += line(pt({
			x: i,
			y: -.7
		}), pt({
			x: i,
			y: 2.5
		}), "#ece7e9") + line(pt({
			x: -1,
			y: i * .7
		}), pt({
			x: 3,
			y: i * .7
		}), "#ece7e9");
		drawing += line({
			x: 55,
			y: cy
		}, {
			x: 385,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 300
		}, {
			x: cx,
			y: 25
		}, "#746a70") + arrow(u, "#8f164d", "u") + arrow(v, "#147d79", "v") + arrow(sum, "#945508", "u+v");
		drawing += line(pt(projection), pt(v), "#147d79", 3, "6 4") + line({
			x: cx,
			y: cy
		}, pt(projection), "#23724a", 5, "7 4");
		drawing += `<path d="M ${cx + 35} ${cy} A 35 35 0 0 0 ${cx + 35 * Math.cos(theta)} ${cy - 35 * Math.sin(theta)}" fill="none" stroke="#626b7c" stroke-width="2"/><text x="${cx + 43 * Math.cos(theta / 2)}" y="${cy - 43 * Math.sin(theta / 2)}" fill="#626b7c">θ</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out=ru]")!.textContent = ru.toFixed(2);
		this.querySelector<HTMLOutputElement>("[data-out=rv]")!.textContent = rv.toFixed(2);
		this.querySelector<HTMLOutputElement>("[data-out=angle]")!.textContent = `${angle}°`;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>⟨u,v⟩ = ${inner.toFixed(3)} · |⟨û,v̂⟩|² = ${probability.toFixed(3)}</strong><br>Cauchy–Schwarz: |${inner.toFixed(3)}| ≤ ${(ru * rv).toFixed(3)}. Triangle inequality: ‖u+v‖ = ${sumNorm.toFixed(3)} ≤ ${(ru + rv).toFixed(3)}. Equality occurs when the directions align.`;
	}
}
if (!customElements.get("inner-product-lab")) customElements.define("inner-product-lab", InnerProductLab);