const point = (originX: number, originY: number, length: number, degrees: number) => {
	const radians = degrees * Math.PI / 180;
	return {
		x: originX + length * Math.cos(radians),
		y: originY - length * Math.sin(radians)
	};
};
document.querySelectorAll<HTMLElement>("[data-note-figure='stretch']").forEach((figure) => {
	const control = figure.querySelector<HTMLInputElement>("[data-figure-control]");
	const input = figure.querySelector<SVGLineElement>("[data-input-vector]");
	const output = figure.querySelector<SVGLineElement>("[data-output-vector]");
	const inputLabel = figure.querySelector<SVGTextElement>("[data-input-label]");
	const outputLabel = figure.querySelector<SVGTextElement>("[data-output-label]");
	const readout = figure.querySelector<HTMLOutputElement>("[data-figure-readout]");
	if (!control || !input || !output || !inputLabel || !outputLabel || !readout) return;
	const update = () => {
		const degrees = Number(control.value);
		const radians = degrees * Math.PI / 180;
		const inputPoint = point(130, 190, 105, degrees);
		const outputPoint = {
			x: 130 + 210 * Math.cos(radians),
			y: 190 - 52.5 * Math.sin(radians)
		};
		input.setAttribute("x2", inputPoint.x.toFixed(2));
		input.setAttribute("y2", inputPoint.y.toFixed(2));
		output.setAttribute("x2", outputPoint.x.toFixed(2));
		output.setAttribute("y2", outputPoint.y.toFixed(2));
		inputLabel.setAttribute("x", (inputPoint.x + 8).toFixed(2));
		inputLabel.setAttribute("y", (inputPoint.y - 7).toFixed(2));
		outputLabel.setAttribute("x", (outputPoint.x + 8).toFixed(2));
		outputLabel.setAttribute("y", (outputPoint.y - 7).toFixed(2));
		readout.textContent = degrees === 0 ? "θ = 0° · eigendirection, λ = 2" : degrees === 90 ? "θ = 90° · eigendirection, λ = 1/2" : `θ = ${degrees}° · Tv is not parallel to v`;
	};
	control.addEventListener("input", update);
	update();
});
document.querySelectorAll<HTMLElement>("[data-note-figure='rotation']").forEach((figure) => {
	const control = figure.querySelector<HTMLInputElement>("[data-figure-control]");
	const output = figure.querySelector<SVGLineElement>("[data-rotation-vector]");
	const outputLabel = figure.querySelector<SVGTextElement>("[data-rotation-label]");
	const arc = figure.querySelector<SVGPathElement>("[data-rotation-arc]");
	const readout = figure.querySelector<HTMLOutputElement>("[data-figure-readout]");
	if (!control || !output || !outputLabel || !arc || !readout) return;
	const update = () => {
		const degrees = Number(control.value);
		const inputDegrees = 20;
		const outputPoint = point(0, 0, 100, inputDegrees + degrees);
		output.setAttribute("x2", outputPoint.x.toFixed(2));
		output.setAttribute("y2", outputPoint.y.toFixed(2));
		outputLabel.setAttribute("x", (outputPoint.x + (outputPoint.x < 0 ? -44 : 7)).toFixed(2));
		outputLabel.setAttribute("y", (outputPoint.y + (outputPoint.y < 0 ? -8 : 16)).toFixed(2));
		const start = point(0, 0, 70, inputDegrees);
		const end = point(0, 0, 70, inputDegrees + degrees);
		if (degrees === 0) {
			arc.setAttribute("d", "");
		} else if (degrees === 360) {
			const opposite = point(0, 0, 70, inputDegrees + 180);
			arc.setAttribute("d", `M${start.x.toFixed(2)} ${start.y.toFixed(2)}A70 70 0 1 0 ${opposite.x.toFixed(2)} ${opposite.y.toFixed(2)}A70 70 0 1 0 ${start.x.toFixed(2)} ${start.y.toFixed(2)}`);
		} else {
			arc.setAttribute("d", `M${start.x.toFixed(2)} ${start.y.toFixed(2)}A70 70 0 ${degrees > 180 ? 1 : 0} 0 ${end.x.toFixed(2)} ${end.y.toFixed(2)}`);
		}
		readout.textContent = degrees === 180 ? "θ = 180° · every real direction is an eigenline, λ = −1" : degrees === 0 || degrees === 360 ? `θ = ${degrees}° · every real direction is an eigenline, λ = 1` : `θ = ${degrees}° · no real eigendirection`;
	};
	control.addEventListener("input", update);
	update();
});