class SpectrumExplorerLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	probeSteps() {
		const raw = this.querySelector<HTMLInputElement>("[data-key=probe]")?.value || "0", match = /^(-?)(\d+)(?:\.(\d+))?$/.exec(raw);
		if (!match) return 0;
		const sign = match[1] === "-" ? -1 : 1, whole = Number(match[2]), fraction = Number((match[3] || "").padEnd(2, "0").slice(0, 2));
		return sign * (whole * 100 + fraction) / 5;
	}
	draw() {
		const kind = this.querySelector<HTMLSelectElement>("[data-operator]")?.value || "compact", resolution = this.get("resolution"), steps = this.probeSteps(), probe = steps / 20;
		let min = -1.5, max = 2.2, values: number[] = [], distance = 0, note = "", spectrumLabel = "", member = false;
		if (kind === "compact") {
			values = Array.from({ length: resolution }, (_, i) => 1 / (i + 1));
			values.push(0);
			min = -.3;
			max = 1.5;
			if (steps <= 0) {
				distance = -probe;
				member = steps === 0;
			} else {
				const centre = 20 / steps, candidates = new Set([
					1,
					Math.max(1, Math.floor(centre)),
					Math.max(1, Math.ceil(centre))
				]);
				distance = Math.min(probe, ...Array.from(candidates, (n) => Math.abs(probe - 1 / n)));
				member = 20 % steps === 0;
			}
			spectrumLabel = "pure-point PVM; 0 ∈ continuous spectrum";
			note = "The distance uses the full set {1/n:n≥1}∪{0}, not merely the displayed points. Here 0 is continuous spectrum, but the PVM is pure point on the eigenvalues 1/n and P({0})=0.";
		} else if (kind === "multiplication") {
			values = Array.from({ length: resolution }, (_, i) => -1 + 2 * i / (resolution - 1));
			min = -1.5;
			max = 1.5;
			member = steps >= -20 && steps <= 20;
			distance = steps < -20 ? -1 - probe : steps > 20 ? probe - 1 : 0;
			spectrumLabel = "non-atomic spectral interval [−1,1]";
			note = "The dots only sample the interval. Multiplication by x has a non-atomic PVM, so its spectral representation is genuinely non-discrete; no non-zero L² eigenfunction is supported at one point.";
		} else {
			values = Array.from({ length: Math.min(resolution, 13) }, (_, i) => i);
			min = -1;
			max = 12.5;
			if (steps < 0) {
				distance = -probe;
			} else {
				const nearest = Math.round(steps / 20);
				distance = Math.abs(probe - nearest);
				member = steps % 20 === 0;
			}
			spectrumLabel = "unbounded point spectrum 0,1,2,…";
			note = "The distance uses the entire non-negative integer spectrum, including values beyond the display. The eigenvalues escape every bounded interval, so this operator is unbounded.";
		}
		min = Math.min(min, probe - .2);
		max = Math.max(max, probe + .2);
		const x = (value: number) => 55 + (value - min) / (max - min) * 390, axisY = 176;
		let drawing = `<line x1="45" y1="${axisY}" x2="455" y2="${axisY}" stroke="#746a70" stroke-width="2"/>`;
		for (let i = 0; i <= 6; i++) {
			const value = min + (max - min) * i / 6, px = x(value);
			drawing += `<line x1="${px}" y1="${axisY - 6}" x2="${px}" y2="${axisY + 6}" stroke="#746a70"/><text x="${px}" y="${axisY + 24}" text-anchor="middle" fill="#626b7c" font-size="11">${value.toFixed(1)}</text>`;
		}
		if (kind === "multiplication") drawing += `<line x1="${x(-1)}" y1="${axisY}" x2="${x(1)}" y2="${axisY}" stroke="#147d79" stroke-width="12" opacity=".35"/>`;
		values.forEach((value, index) => {
			drawing += `<circle cx="${x(value)}" cy="${axisY - index % 3 * 18}" r="${kind === "multiplication" ? 4 : 6}" fill="${value === 0 ? "#147d79" : "#8f164d"}" opacity="${kind === "multiplication" ? .65 : 1}"/>`;
		});
		const probeX = x(probe);
		drawing += `<line x1="${probeX}" y1="65" x2="${probeX}" y2="285" stroke="#945508" stroke-width="4" stroke-dasharray="7 5"/><circle cx="${probeX}" cy="65" r="7" fill="#945508"/><text x="${probeX + 9}" y="58" fill="#945508" font-weight="700">z=${probe.toFixed(2)}</text><text x="250" y="315" text-anchor="middle" fill="#626b7c">${spectrumLabel}</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out=resolution]")!.textContent = String(resolution);
		this.querySelector<HTMLOutputElement>("[data-out=probe]")!.textContent = probe.toFixed(2);
		const resolvent = member ? "The probe lies in the exact spectrum, so T−zI has no bounded inverse." : `For this normal model, ‖(T−zI)⁻¹‖=1/dist(z,σ)≈${(1 / distance).toFixed(2)}.`;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>Exact membership: ${member ? "z ∈ σ(T)" : "z ∉ σ(T)"} · dist(z, σ(T)) ${member ? "= 0" : `≈ ${distance.toFixed(3)}`}</strong><br>${resolvent} ${note}`;
	}
}
if (!customElements.get("spectrum-explorer-lab")) customElements.define("spectrum-explorer-lab", SpectrumExplorerLab);