class SubspaceLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	value(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const theta = this.value("theta"), phi = this.value("phi"), a = this.value("a"), b = this.value("b");
		const shifted = this.querySelector<HTMLInputElement>("[data-key=affine]")?.checked || false;
		const rad = (degrees: number) => degrees * Math.PI / 180;
		const u = {
			x: Math.cos(rad(theta)),
			y: Math.sin(rad(theta))
		}, w = {
			x: Math.cos(rad(phi)),
			y: Math.sin(rad(phi))
		};
		const v = {
			x: a * u.x + b * w.x,
			y: a * u.y + b * w.y
		};
		const canonical = (angle: number) => (angle % 180 + 180) % 180;
		const rawSeparation = Math.abs(canonical(theta) - canonical(phi));
		const separation = Math.min(rawSeparation, 180 - rawSeparation);
		const direct = separation !== 0;
		const numericallyClose = direct && separation <= 2;
		this.querySelectorAll<HTMLInputElement>("[data-key=\"a\"], [data-key=\"b\"]").forEach((input) => {
			input.disabled = shifted;
		});
		const cx = 220, cy = 170, scale = 70;
		const point = (q: {
			x: number;
			y: number;
		}) => ({
			x: cx + q.x * scale,
			y: cy - q.y * scale
		});
		const line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		const arrow = (q: {
			x: number;
			y: number;
		}, color: string, label: string) => {
			const end = point(q);
			return `${line({
				x: cx,
				y: cy
			}, end, color, 4)}<circle cx="${end.x}" cy="${end.y}" r="5" fill="${color}"/><text x="${end.x + 8}" y="${end.y - 8}" fill="${color}" font-weight="700">${label}</text>`;
		};
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70");
		const normal = {
			x: -u.y,
			y: u.x
		}, offset = shifted ? .65 : 0;
		const uq1 = point({
			x: normal.x * offset - u.x * 2.2,
			y: normal.y * offset - u.y * 2.2
		}), uq2 = point({
			x: normal.x * offset + u.x * 2.2,
			y: normal.y * offset + u.y * 2.2
		});
		drawing += line(uq1, uq2, "#8f164d", 4, shifted ? "8 5" : "") + line(point({
			x: -w.x * 2.2,
			y: -w.y * 2.2
		}), point({
			x: w.x * 2.2,
			y: w.y * 2.2
		}), "#147d79", 4);
		if (shifted) {
			const anchor = point({
				x: normal.x * offset,
				y: normal.y * offset
			});
			drawing += `<circle cx="${anchor.x}" cy="${anchor.y}" r="5" fill="#8f164d"/><text x="${anchor.x + 8}" y="${anchor.y - 8}" fill="#8f164d" font-weight="700">q</text>`;
		} else {
			drawing += arrow({
				x: a * u.x,
				y: a * u.y
			}, "#8f164d", "au") + arrow(v, "#945508", "au+bw");
			const au = point({
				x: a * u.x,
				y: a * u.y
			}), end = point(v);
			drawing += line(au, end, "#147d79", 3, "6 4");
		}
		drawing += `<text x="75" y="32" fill="#8f164d" font-weight="700">U${shifted ? " + q" : ""}</text><text x="340" y="32" fill="#147d79" font-weight="700">W</text>`;
		const svg = this.querySelector("svg")!;
		svg.innerHTML = drawing;
		svg.setAttribute("aria-label", shifted ? "An affine line U plus q, which misses the origin, together with the direction subspace W. Vector-subspace sums are suppressed in affine mode." : `Two vector subspaces U and W with angular separation ${separation} degrees. ${direct ? "Their directions are exactly distinct and form a direct sum." : "Their directions are exactly coincident."}`);
		this.querySelector<HTMLOutputElement>("[data-out=theta]")!.textContent = `${theta}°`;
		this.querySelector<HTMLOutputElement>("[data-out=phi]")!.textContent = `${phi}°`;
		const summary = this.querySelector<HTMLElement>("[data-summary]")!;
		if (shifted) {
			summary.innerHTML = "<strong>Affine mode: U+q is not a vector subspace.</strong><br>It misses 0, so scalar multiplication and direct-sum notation do not apply. The coefficient controls and vector-sum arrows are suppressed; U still records the underlying direction only.";
		} else {
			const proximity = numericallyClose ? `<br><em>Numerical proximity:</em> the ${separation}° separation is small, but it is not exact coincidence.` : "";
			summary.innerHTML = `<strong>au+bw = (${v.x.toFixed(2)}, ${v.y.toFixed(2)})</strong><br>${direct ? "Exact classification: U⊕W = ℝ² and the decomposition is unique." : "Exact classification: U=W, so the sum is one line and decompositions are non-unique."}${proximity}<br>U and W contain 0 and are closed under real linear combinations.`;
		}
	}
}
if (!customElements.get("subspace-lab")) customElements.define("subspace-lab", SubspaceLab);