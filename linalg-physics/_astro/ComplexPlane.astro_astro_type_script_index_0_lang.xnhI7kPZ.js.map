class ComplexPlaneLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	values() {
		const value = (key: string) => Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
		return {
			a: value("a"),
			b: value("b"),
			c: value("c"),
			d: value("d")
		};
	}
	draw() {
		const { a, b, c, d } = this.values();
		const product = {
			x: a * c - b * d,
			y: a * d + b * c
		};
		const vectors = [
			{
				x: a,
				y: b,
				color: "#64113f",
				label: "z"
			},
			{
				x: c,
				y: d,
				color: "#175b68",
				label: "w"
			},
			{
				...product,
				color: "#bf6d19",
				label: "zw"
			}
		];
		const scale = Math.max(2.5, ...vectors.map((v) => Math.max(Math.abs(v.x), Math.abs(v.y)))) * 1.2;
		const sx = (x: number) => 210 + x * 140 / scale;
		const sy = (y: number) => 170 - y * 140 / scale;
		const grid = Array.from({ length: 9 }, (_, i) => -4 + i).map((n) => {
			const p = n * scale / 4;
			return `<line x1="${sx(p)}" y1="30" x2="${sx(p)}" y2="310" stroke="#ebe5e8"/><line x1="70" y1="${sy(p)}" x2="350" y2="${sy(p)}" stroke="#ebe5e8"/>`;
		}).join("");
		const arrows = vectors.map((v) => `<line x1="210" y1="170" x2="${sx(v.x)}" y2="${sy(v.y)}" stroke="${v.color}" stroke-width="4" marker-end="url(#arrow-${v.label})"/><circle cx="${sx(v.x)}" cy="${sy(v.y)}" r="5" fill="${v.color}"/><text x="${sx(v.x) + 8}" y="${sy(v.y) - 8}" fill="${v.color}" font-weight="700">${v.label}</text>`).join("");
		const defs = vectors.map((v) => `<marker id="arrow-${v.label}" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="${v.color}"/></marker>`).join("");
		const svg = this.querySelector("svg")!;
		svg.innerHTML = `<defs>${defs}</defs>${grid}<line x1="65" y1="170" x2="355" y2="170" stroke="#756a70" stroke-width="1.5"/><line x1="210" y1="315" x2="210" y2="25" stroke="#756a70" stroke-width="1.5"/><text x="355" y="163" fill="#756a70">Re</text><text x="218" y="28" fill="#756a70">Im</text>${arrows}`;
		const modulus = (x: number, y: number) => Math.hypot(x, y);
		const angle = (x: number, y: number) => Math.atan2(y, x) * 180 / Math.PI;
		const formatNumber = (value: number) => {
			if (value === 0) return "0.00";
			const magnitude = Math.abs(value);
			return magnitude < .005 || magnitude >= 1e4 ? value.toExponential(2) : value.toFixed(2);
		};
		const formatComplex = (x: number, y: number) => `${formatNumber(x)} ${y < 0 ? "−" : "+"} ${formatNumber(Math.abs(y))}i`;
		const zMod = modulus(a, b), wMod = modulus(c, d), productMod = modulus(product.x, product.y);
		const sumAngle = angle(a, b) + angle(c, d), productAngle = angle(product.x, product.y);
		const zIsZero = a === 0 && b === 0;
		const wIsZero = c === 0 && d === 0;
		const angleDetail = zIsZero || wIsZero ? "The argument is undefined when either factor is zero." : `arg(zw) = ${productAngle.toFixed(1)}°, congruent to arg z + arg w = ${sumAngle.toFixed(1)}° modulo 360°.`;
		const quotientDetail = wIsZero ? "z/w is undefined because w=0." : `z/w = ${formatComplex((a * c + b * d) / (c * c + d * d), (b * c - a * d) / (c * c + d * d))}.`;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>zw = ${formatComplex(product.x, product.y)}</strong><br>|zw| = ${formatNumber(productMod)} and |z||w| = ${formatNumber(zMod * wMod)}. ${angleDetail}<br>conj(z) = ${formatComplex(a, -b)}. ${quotientDetail}`;
	}
}
if (!customElements.get("complex-plane-lab")) customElements.define("complex-plane-lab", ComplexPlaneLab);