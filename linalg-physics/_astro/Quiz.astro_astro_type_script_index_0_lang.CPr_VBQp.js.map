interface Question {
	id: string;
	type: "choice" | "numeric";
	prompt: string;
	options?: string[];
	answer: number;
	tolerance?: number;
	hint: string;
	explanation: string;
}
interface QuestionResult {
	id: string;
	correct: boolean;
	attempts: number;
	hintUsed: boolean;
}
interface StoredResult {
	score?: number;
	mastered?: number;
	firstTry?: number;
	total: number;
	best?: number;
	attempts?: number;
	completedAt?: string;
}
class SelfQuiz extends HTMLElement {
	sourceQuestions: Question[] = [];
	questions: Question[] = [];
	current = 0;
	mastered = 0;
	firstTry = 0;
	questionAttempts = 0;
	hintUsed = false;
	checked = false;
	results: QuestionResult[] = [];
	body!: HTMLElement;
	progress!: HTMLElement;
	history!: HTMLElement;
	connectedCallback() {
		this.sourceQuestions = JSON.parse(this.dataset.questions || "[]");
		this.questions = this.prepareQuestions(this.sourceQuestions);
		this.body = this.querySelector(".quiz-body") as HTMLElement;
		this.progress = this.querySelector(".quiz-progress") as HTMLElement;
		this.history = this.querySelector("[data-history]") as HTMLElement;
		this.renderHistory();
		this.render();
	}
	escape(value: string) {
		return value.replace(/[&<>'"]/g, (character) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			"'": "&#39;",
			"\"": "&quot;"
		})[character] || character);
	}
	shuffled<T,>(items: T[]): T[] {
		const result = [...items];
		for (let index = result.length - 1; index > 0; index -= 1) {
			const random = new Uint32Array(1);
			crypto.getRandomValues(random);
			const swap = random[0] % (index + 1);
			[result[index], result[swap]] = [result[swap], result[index]];
		}
		return result;
	}
	prepareQuestions(questions: Question[]): Question[] {
		return questions.map((question) => {
			if (question.type !== "choice" || !question.options) return { ...question };
			const options = this.shuffled(question.options.map((label, index) => ({
				label,
				correct: index === question.answer
			})));
			return {
				...question,
				options: options.map((option) => option.label),
				answer: options.findIndex((option) => option.correct)
			};
		});
	}
	storageKey() {
		return `linalg-quiz-${this.dataset.lecture}`;
	}
	storedResult(): StoredResult | null {
		try {
			const stored = localStorage.getItem(this.storageKey());
			return stored ? JSON.parse(stored) : null;
		} catch {
			return null;
		}
	}
	renderHistory() {
		const stored = this.storedResult();
		if (!stored) return;
		const latest = stored.mastered ?? stored.score ?? 0;
		const best = stored.best ?? latest;
		const date = stored.completedAt ? new Intl.DateTimeFormat(undefined, {
			day: "numeric",
			month: "short"
		}).format(new Date(stored.completedAt)) : "previous attempt";
		this.history.hidden = false;
		this.history.innerHTML = `<strong>Previous result</strong><span>${latest}/${stored.total} mastered · best ${best}/${stored.total} · ${this.escape(date)}</span>`;
	}
	setProgress(value: number) {
		const bar = this.progress.querySelector<HTMLElement>("span");
		if (bar) bar.style.width = `${value / this.questions.length * 100}%`;
		this.progress.setAttribute("aria-valuenow", String(value));
		this.progress.setAttribute("aria-valuetext", `${value} of ${this.questions.length} questions completed`);
	}
	render(focus = false) {
		if (!this.questions.length) return;
		if (this.current >= this.questions.length) {
			this.finish(focus);
			return;
		}
		const question = this.questions[this.current];
		this.checked = false;
		this.setProgress(this.current);
		const answer = question.type === "choice" ? `<div class="quiz-options">${(question.options || []).map((option, index) => `
            <label class="quiz-option"><input type="radio" name="quiz-${this.dataset.lecture}-${this.current}" value="${index}" /> <span>${this.escape(option)}</span></label>`).join("")}</div>` : `<label class="control-group quiz-number-answer"><span>Your answer</span><input class="number-field" type="number" step="any" inputmode="decimal" data-numeric /></label>`;
		this.body.innerHTML = `
        <div class="quiz-kicker">Question ${this.current + 1} of ${this.questions.length}</div>
        <fieldset class="quiz-fieldset">
          <legend class="quiz-question" data-question-focus tabindex="-1">${this.escape(question.prompt)}</legend>
          ${answer}
        </fieldset>
        <div class="quiz-feedback" role="status" aria-live="polite"></div>
        <div class="quiz-actions">
          <button class="small-button" data-action="check">Check answer</button>
          <button class="small-button secondary" data-action="hint">Use a hint</button>
        </div>`;
		this.body.querySelector("[data-action=check]")?.addEventListener("click", () => this.check(question));
		this.body.querySelector("[data-action=hint]")?.addEventListener("click", () => this.hint(question));
		if (focus) requestAnimationFrame(() => this.body.querySelector<HTMLElement>("[data-question-focus]")?.focus());
	}
	selected(question: Question): number | null {
		if (question.type === "numeric") {
			const input = this.body.querySelector<HTMLInputElement>("[data-numeric]");
			return input && input.value !== "" ? Number(input.value) : null;
		}
		const input = this.body.querySelector<HTMLInputElement>("input[type=\"radio\"]:checked");
		return input ? Number(input.value) : null;
	}
	check(question: Question) {
		if (this.checked) return;
		const selected = this.selected(question);
		const feedback = this.body.querySelector(".quiz-feedback") as HTMLElement;
		if (selected === null || Number.isNaN(selected)) {
			feedback.className = "quiz-feedback incorrect";
			feedback.textContent = "Choose or enter an answer first.";
			return;
		}
		this.questionAttempts += 1;
		const correct = question.type === "numeric" ? Math.abs(selected - question.answer) <= (question.tolerance ?? 0) : selected === question.answer;
		if (!correct && this.questionAttempts < 2) {
			feedback.className = "quiz-feedback incorrect";
			feedback.textContent = "Not yet. Reconsider your answer or use the hint, then try once more.";
			return;
		}
		this.checked = true;
		if (correct) {
			this.mastered += 1;
			if (this.questionAttempts === 1 && !this.hintUsed) this.firstTry += 1;
		}
		this.results.push({
			id: question.id,
			correct,
			attempts: this.questionAttempts,
			hintUsed: this.hintUsed
		});
		feedback.className = `quiz-feedback ${correct ? "correct" : "incorrect"}`;
		feedback.textContent = `${correct ? this.questionAttempts === 1 && !this.hintUsed ? "Correct independently. " : "Correct after revisiting it. " : "Review this one. "}${question.explanation}`;
		const actions = this.body.querySelector(".quiz-actions") as HTMLElement;
		actions.innerHTML = `<button class="small-button" data-action="next">${this.current + 1 === this.questions.length ? "See result" : "Next question"}</button>`;
		actions.querySelector("button")?.addEventListener("click", () => {
			this.current += 1;
			this.questionAttempts = 0;
			this.hintUsed = false;
			this.render(true);
		});
	}
	hint(question: Question) {
		this.hintUsed = true;
		const feedback = this.body.querySelector(".quiz-feedback") as HTMLElement;
		feedback.className = "quiz-feedback hint";
		feedback.textContent = `Hint: ${question.hint}`;
	}
	finish(focus: boolean) {
		this.setProgress(this.questions.length);
		const percent = Math.round(this.mastered / this.questions.length * 100);
		const review = this.results.map((result, index) => {
			const question = this.sourceQuestions.find((candidate) => candidate.id === result.id)!;
			const label = result.correct ? result.attempts === 1 && !result.hintUsed ? "Independent" : "Recovered" : "Review";
			return `<details class="quiz-review-item ${result.correct ? "correct" : "incorrect"}"><summary><span>${index + 1}</span>${this.escape(question.prompt)}<strong>${label}</strong></summary><p>${this.escape(question.explanation)}</p></details>`;
		}).join("");
		this.body.innerHTML = `
        <div class="quiz-score" data-question-focus tabindex="-1">
          <p class="quiz-kicker">Self-check complete</p>
          <h3>${this.mastered} of ${this.questions.length} mastered · ${this.firstTry} independently</h3>
          <p>${percent === 100 ? "Every item was recovered. Use the review below to consolidate the reasoning." : "Review the flagged explanations, revisit the matching objective, then take a fresh attempt."}</p>
        </div>
        <div class="quiz-review"><h4>Review this attempt</h4>${review}</div>
        <div class="quiz-actions quiz-finish-actions"><button class="small-button" data-action="restart">Start a fresh attempt</button></div>`;
		const previous = this.storedResult();
		const previousBest = previous?.best ?? previous?.mastered ?? previous?.score ?? 0;
		const stored: StoredResult = {
			mastered: this.mastered,
			firstTry: this.firstTry,
			total: this.questions.length,
			best: Math.max(previousBest, this.mastered),
			attempts: (previous?.attempts || 0) + 1,
			completedAt: new Date().toISOString()
		};
		try {
			localStorage.setItem(this.storageKey(), JSON.stringify(stored));
		} catch {}
		this.renderHistory();
		window.dispatchEvent(new CustomEvent("linalg-quiz-complete", { detail: { lecture: this.dataset.lecture } }));
		this.body.querySelector("[data-action=restart]")?.addEventListener("click", () => this.restart());
		if (focus) requestAnimationFrame(() => this.body.querySelector<HTMLElement>("[data-question-focus]")?.focus());
	}
	restart() {
		this.questions = this.prepareQuestions(this.sourceQuestions);
		this.current = 0;
		this.mastered = 0;
		this.firstTry = 0;
		this.questionAttempts = 0;
		this.hintUsed = false;
		this.checked = false;
		this.results = [];
		this.render(true);
	}
}
if (!customElements.get("self-quiz")) customElements.define("self-quiz", SelfQuiz);