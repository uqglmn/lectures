class OperatorClassifierLab extends HTMLElement {
	connectedCallback() {
		this.querySelector("select")?.addEventListener("input", () => this.draw());
		this.draw();
	}
	draw() {
		const examples = {
			hermitian: {
				matrix: "[1  i; −i  2]",
				adjoint: "A† = A",
				self: true,
				unitary: false,
				normal: true,
				eigen: [[.382, 0], [2.618, 0]],
				note: "Self-adjoint operators represent observables: every eigenvalue is real and eigendirections for different eigenvalues are orthogonal."
			},
			swap: {
				matrix: "[0  1; 1  0]",
				adjoint: "A† = A = A⁻¹",
				self: true,
				unitary: true,
				normal: true,
				eigen: [[-1, 0], [1, 0]],
				note: "The swap is simultaneously an observable and a symmetry. Its real eigenvalues also lie on the unit circle."
			},
			phase: {
				matrix: "[i  0; 0  −i]",
				adjoint: "A† = A⁻¹ = −A",
				self: false,
				unitary: true,
				normal: true,
				eigen: [[0, 1], [0, -1]],
				note: "A unitary preserves every inner product. Its eigenvalues are phases on the unit circle, but need not be real."
			},
			normal: {
				matrix: "[2  0; 0  i]",
				adjoint: "A† = [2  0; 0  −i]",
				self: false,
				unitary: false,
				normal: true,
				eigen: [[2, 0], [0, 1]],
				note: "Diagonal operators are normal. This one is neither self-adjoint nor unitary, showing that normal is the broader spectral-theorem class."
			},
			shear: {
				matrix: "[1  1; 0  1]",
				adjoint: "A† = [1  0; 1  1]",
				self: false,
				unitary: false,
				normal: false,
				eigen: [[1, 0], [1, 0]],
				note: "The shear does not commute with its adjoint. Its repeated eigenvalue has only one eigendirection, so orthogonal diagonalization fails."
			}
		} as const;
		const key = this.querySelector<HTMLSelectElement>("[data-example]")?.value as keyof typeof examples || "hermitian", item = examples[key];
		const checks = [
			[
				"Self-adjoint",
				item.self,
				"A† = A"
			],
			[
				"Unitary",
				item.unitary,
				"A†A = I"
			],
			[
				"Normal",
				item.normal,
				"A†A = AA†"
			]
		];
		this.querySelector<HTMLElement>("[data-checks]")!.innerHTML = checks.map(([label, pass, test]) => `<div class="operator-check ${pass ? "pass" : "fail"}"><span>${pass ? "✓" : "×"}</span><div><strong>${label}</strong><small>${test}</small></div></div>`).join("");
		const format = (z: readonly number[]) => {
			const [re, im] = z;
			if (im === 0) return Number(re.toPrecision(4)).toString();
			if (re === 0) return `${im < 0 ? "−" : ""}${Math.abs(im) === 1 ? "" : Number(Math.abs(im).toPrecision(4))}i`;
			return `${Number(re.toPrecision(4))}${im < 0 ? " − " : " + "}${Math.abs(im) === 1 ? "" : Number(Math.abs(im).toPrecision(4))}i`;
		};
		const eigenText = item.eigen.map(format), classText = `self-adjoint: ${item.self ? "yes" : "no"}; unitary: ${item.unitary ? "yes" : "no"}; normal: ${item.normal ? "yes" : "no"}`;
		const cx = 220, cy = 170, maxCoordinate = Math.max(1, ...item.eigen.flatMap((z) => [Math.abs(z[0]), Math.abs(z[1])])), bound = Math.max(1.35, maxCoordinate * 1.25), s = 128 / bound;
		const line = (x1: number, y1: number, x2: number, y2: number, color: string, width = 2, dash = "") => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = `<title>Eigenvalues ${eigenText.join(" and ")}; ${classText}</title>`;
		for (let i = -2; i <= 2; i++) drawing += line(cx + i * 64, 35, cx + i * 64, 305, "#ece7e9") + line(75, cy + i * 64, 365, cy + i * 64, "#ece7e9");
		drawing += line(65, cy, 375, cy, "#746a70") + line(cx, 315, cx, 25, "#746a70") + `<circle cx="${cx}" cy="${cy}" r="${s}" fill="none" stroke="#147d79" stroke-width="3" stroke-dasharray="7 5"/><text x="${cx - s - 6}" y="${Math.min(305, cy + s + 18)}" text-anchor="end" fill="#147d79">unit circle</text><text x="365" y="190" fill="#626b7c">Re</text><text x="230" y="30" fill="#626b7c">Im</text>`;
		item.eigen.forEach((z, index) => {
			const x = cx + z[0] * s, y = cy - z[1] * s, label = `λ${index + 1} = ${eigenText[index]}`, right = x < 300, tx = right ? x + 9 : x - 9, anchor = right ? "start" : "end", ty = Math.min(315, Math.max(25, y + (index ? 24 : -12)));
			drawing += `<circle cx="${x}" cy="${y}" r="7" fill="${index ? "#945508" : "#8f164d"}"/><text x="${tx}" y="${ty}" text-anchor="${anchor}" fill="${index ? "#945508" : "#8f164d"}" font-weight="700">${label}</text>`;
		});
		const svg = this.querySelector("svg")!;
		svg.innerHTML = drawing;
		svg.setAttribute("aria-label", `Selected matrix ${item.matrix}. Numerical eigenvalues ${eigenText.join(" and ")}. Exact class membership: ${classText}.`);
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>A = ${item.matrix}</strong><br>${item.adjoint}. <strong>Eigenvalues: ${eigenText.join(", ")}.</strong><br><strong>Exact classes:</strong> ${classText}. ${item.note}`;
	}
}
if (!customElements.get("operator-classifier-lab")) customElements.define("operator-classifier-lab", OperatorClassifierLab);