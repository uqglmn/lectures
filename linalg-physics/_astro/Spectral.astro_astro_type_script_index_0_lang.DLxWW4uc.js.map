class SpectralLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const a = this.get("a"), b = this.get("b"), d = this.get("d");
		const mirror = this.querySelector<HTMLInputElement>("[data-key=b2]");
		if (mirror) mirror.value = String(b);
		const trace = a + d, delta = Math.sqrt((a - d) * (a - d) + 4 * b * b);
		const l1 = (trace + delta) / 2, l2 = (trace - delta) / 2;
		let e1: {
			x: number;
			y: number;
		};
		if (Math.abs(b) > 1e-10) {
			e1 = {
				x: b,
				y: l1 - a
			};
			const n = Math.hypot(e1.x, e1.y);
			e1 = {
				x: e1.x / n,
				y: e1.y / n
			};
		} else e1 = a >= d ? {
			x: 1,
			y: 0
		} : {
			x: 0,
			y: 1
		};
		const e2 = {
			x: -e1.y,
			y: e1.x
		};
		const angle = Number(this.querySelector<HTMLInputElement>("[data-angle]")?.value || 0);
		const radians = angle * Math.PI / 180, psi = {
			x: Math.cos(radians),
			y: Math.sin(radians)
		};
		const amp1 = e1.x * psi.x + e1.y * psi.y, amp2 = e2.x * psi.x + e2.y * psi.y, p1 = amp1 * amp1, p2 = amp2 * amp2;
		const cx = 220, cy = 170, s = 115;
		const p = (v: {
			x: number;
			y: number;
		}, k = 1) => ({
			x: cx + v.x * s * k,
			y: cy - v.y * s * k
		});
		const line = (u: {
			x: number;
			y: number;
		}, v: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${u.x}" y1="${u.y}" x2="${v.x}" y2="${v.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (let i = -3; i <= 3; i++) {
			const q = cx + i * 46;
			drawing += `<line x1="${q}" y1="25" x2="${q}" y2="315" stroke="#ece7e9"/><line x1="75" y1="${cy + i * 46}" x2="365" y2="${cy + i * 46}" stroke="#ece7e9"/>`;
		}
		drawing += line({
			x: 65,
			y: cy
		}, {
			x: 375,
			y: cy
		}, "#746a70", 1) + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70", 1);
		drawing += line(p(e1, -1.35), p(e1, 1.35), "#64113f", 4) + line(p(e2, -1.35), p(e2, 1.35), "#175b68", 4);
		drawing += line({
			x: cx,
			y: cy
		}, p(psi), "#bf6d19", 5) + `<circle cx="${p(psi).x}" cy="${p(psi).y}" r="6" fill="#bf6d19"/><text x="${p(psi).x + 8}" y="${p(psi).y - 8}" fill="#bf6d19" font-weight="700">ψ</text>`;
		const pr1 = p(e1, amp1), pr2 = p(e2, amp2);
		drawing += line({
			x: cx,
			y: cy
		}, pr1, "#64113f", 7, "7 4") + line({
			x: cx,
			y: cy
		}, pr2, "#175b68", 7, "7 4");
		drawing += `<text x="${p(e1, 1.43).x}" y="${p(e1, 1.43).y}" fill="#64113f" font-weight="700">e₁</text><text x="${p(e2, 1.43).x}" y="${p(e2, 1.43).y}" fill="#175b68" font-weight="700">e₂</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-angle-label]")!.textContent = `${angle}°`;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>λ₁ = ${l1.toFixed(3)}, λ₂ = ${l2.toFixed(3)}</strong><br>P(λ₁) = |⟨e₁,ψ⟩|² = ${p1.toFixed(3)}<br>P(λ₂) = |⟨e₂,ψ⟩|² = ${p2.toFixed(3)}.`;
	}
}
if (!customElements.get("spectral-lab")) customElements.define("spectral-lab", SpectralLab);