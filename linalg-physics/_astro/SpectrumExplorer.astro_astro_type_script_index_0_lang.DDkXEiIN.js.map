class SpectrumExplorerLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const kind = this.querySelector<HTMLSelectElement>("[data-operator]")?.value || "compact", resolution = this.get("resolution"), probe = this.get("probe");
		let min = -1.5, max = 2.2, values: number[] = [], distance = 0, note = "", spectrumLabel = "";
		if (kind === "compact") {
			values = Array.from({ length: resolution }, (_, i) => 1 / (i + 1));
			values.push(0);
			min = -.3;
			max = 1.5;
			distance = Math.min(...values.map((value) => Math.abs(probe - value)));
			spectrumLabel = "point spectrum accumulating at 0";
			note = "The non-zero eigenvalues have finite multiplicity and converge to 0, exactly the compact self-adjoint pattern.";
		} else if (kind === "multiplication") {
			values = Array.from({ length: resolution }, (_, i) => -1 + 2 * i / (resolution - 1));
			min = -1.5;
			max = 1.5;
			distance = probe < -1 ? -1 - probe : probe > 1 ? probe - 1 : 0;
			spectrumLabel = "continuous interval [−1,1]";
			note = "The dots only sample the interval. In the actual L² operator, every λ∈[−1,1] is spectral although no non-zero L² eigenfunction is supported at one point.";
		} else {
			values = Array.from({ length: Math.min(resolution, 13) }, (_, i) => i);
			min = -1;
			max = 12.5;
			distance = Math.min(...values.map((value) => Math.abs(probe - value)));
			spectrumLabel = "unbounded point spectrum 0,1,2,…";
			note = "The eigenvalues escape every bounded interval. This cannot be a bounded operator; increasing the display reveals ever larger spectral values.";
		}
		min = Math.min(min, probe - .2);
		max = Math.max(max, probe + .2);
		const x = (value: number) => 55 + (value - min) / (max - min) * 390, axisY = 176;
		let drawing = `<line x1="45" y1="${axisY}" x2="455" y2="${axisY}" stroke="#746a70" stroke-width="2"/>`;
		for (let i = 0; i <= 6; i++) {
			const value = min + (max - min) * i / 6, px = x(value);
			drawing += `<line x1="${px}" y1="${axisY - 6}" x2="${px}" y2="${axisY + 6}" stroke="#746a70"/><text x="${px}" y="${axisY + 24}" text-anchor="middle" fill="#626b7c" font-size="11">${value.toFixed(1)}</text>`;
		}
		if (kind === "multiplication") drawing += `<line x1="${x(-1)}" y1="${axisY}" x2="${x(1)}" y2="${axisY}" stroke="#147d79" stroke-width="12" opacity=".35"/>`;
		values.forEach((value, index) => {
			drawing += `<circle cx="${x(value)}" cy="${axisY - index % 3 * 18}" r="${kind === "multiplication" ? 4 : 6}" fill="${value === 0 ? "#147d79" : "#8f164d"}" opacity="${kind === "multiplication" ? .65 : 1}"/>`;
		});
		const probeX = x(probe);
		drawing += `<line x1="${probeX}" y1="65" x2="${probeX}" y2="285" stroke="#945508" stroke-width="4" stroke-dasharray="7 5"/><circle cx="${probeX}" cy="65" r="7" fill="#945508"/><text x="${probeX + 9}" y="58" fill="#945508" font-weight="700">z=${probe.toFixed(2)}</text><text x="250" y="315" text-anchor="middle" fill="#626b7c">${spectrumLabel}</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out=resolution]")!.textContent = String(resolution);
		this.querySelector<HTMLOutputElement>("[data-out=probe]")!.textContent = probe.toFixed(2);
		const resolvent = distance > 1e-6 ? `For this normal model, the resolvent scale is approximately 1/dist(z,σ) = ${(1 / distance).toFixed(2)}.` : "The probe lies on the displayed spectrum, so T−zI has no bounded inverse.";
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>dist(z, σ(T)) ${distance < 1e-6 ? "= 0" : `≈ ${distance.toFixed(3)}`}</strong><br>${resolvent} ${note}`;
	}
}
if (!customElements.get("spectrum-explorer-lab")) customElements.define("spectrum-explorer-lab", SpectrumExplorerLab);