class PerturbationLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	values(epsilon: number, gap: number, coupling: number, slope: number) {
		const half = gap / 2, root = Math.hypot(half - slope * epsilon, coupling * epsilon);
		const firstFromLower = -half + slope * epsilon, firstFromUpper = half - slope * epsilon;
		const uncoupled = coupling === 0;
		return {
			exactFromLower: uncoupled ? firstFromLower : -root,
			exactFromUpper: uncoupled ? firstFromUpper : root,
			firstFromLower,
			firstFromUpper,
			secondFromLower: firstFromLower - coupling * coupling * epsilon * epsilon / gap,
			secondFromUpper: firstFromUpper + coupling * coupling * epsilon * epsilon / gap
		};
	}
	draw() {
		const epsilon = this.get("epsilon"), gap = this.get("gap"), coupling = this.get("coupling"), slope = this.get("slope");
		const samples = Array.from({ length: 161 }, (_, index) => -1 + 2 * index / 160);
		const series = samples.map((value) => ({
			epsilon: value,
			...this.values(value, gap, coupling, slope)
		}));
		const all = series.flatMap((point) => [
			point.exactFromLower,
			point.exactFromUpper,
			point.secondFromLower,
			point.secondFromUpper
		]);
		const pad = Math.max(.35, (Math.max(...all) - Math.min(...all)) * .08), yMin = Math.min(...all) - pad, yMax = Math.max(...all) + pad;
		const x = (value: number) => 58 + (value + 1) / 2 * 420, y = (value: number) => 292 - (value - yMin) / (yMax - yMin) * 234;
		const path = (key: "exactFromLower" | "exactFromUpper" | "firstFromLower" | "firstFromUpper" | "secondFromLower" | "secondFromUpper") => series.map((point, index) => `${index ? "L" : "M"}${x(point.epsilon).toFixed(1)},${y(point[key]).toFixed(1)}`).join(" ");
		let drawing = "";
		for (let index = 0; index <= 4; index++) {
			const px = 58 + index * 105, value = -1 + index * .5;
			drawing += `<line x1="${px}" y1="58" x2="${px}" y2="292" stroke="#ece7e9"/><text x="${px}" y="314" text-anchor="middle" fill="#626b7c" font-size="11">${value.toFixed(1)}</text>`;
		}
		for (let index = 0; index <= 4; index++) {
			const value = yMin + (yMax - yMin) * index / 4, py = y(value);
			drawing += `<line x1="58" y1="${py}" x2="478" y2="${py}" stroke="#ece7e9"/><text x="49" y="${py + 4}" text-anchor="end" fill="#626b7c" font-size="11">${value.toFixed(1)}</text>`;
		}
		drawing += `<line x1="58" y1="292" x2="478" y2="292" stroke="#746a70"/><text x="268" y="334" text-anchor="middle" fill="#626b7c">ε</text>`;
		drawing += `<path d="${path("firstFromLower")}" fill="none" stroke="#9b9297" stroke-width="2" stroke-dasharray="3 6"/><path d="${path("firstFromUpper")}" fill="none" stroke="#9b9297" stroke-width="2" stroke-dasharray="3 6"/>`;
		drawing += `<path d="${path("secondFromLower")}" fill="none" stroke="#bf6d19" stroke-width="2.5" stroke-dasharray="8 5"/><path d="${path("secondFromUpper")}" fill="none" stroke="#bf6d19" stroke-width="2.5" stroke-dasharray="8 5"/>`;
		drawing += `<path d="${path("exactFromLower")}" fill="none" stroke="#64113f" stroke-width="4"/><path d="${path("exactFromUpper")}" fill="none" stroke="#147d79" stroke-width="4"/>`;
		const current = this.values(epsilon, gap, coupling, slope), px = x(epsilon), norm = Math.hypot(slope, coupling), radius = Math.abs(epsilon) * norm, half = gap / 2;
		for (const centre of [-half, half]) drawing += `<line x1="${px}" y1="${y(centre - radius)}" x2="${px}" y2="${y(centre + radius)}" stroke="#f4b95f" stroke-width="12" opacity=".38"/>`;
		drawing += `<line x1="${px}" y1="58" x2="${px}" y2="292" stroke="#263a50" stroke-width="2" stroke-dasharray="5 5"/><circle cx="${px}" cy="${y(current.exactFromLower)}" r="6" fill="#64113f"/><rect x="${px - 5}" y="${y(current.exactFromUpper) - 5}" width="10" height="10" rx="1" fill="#147d79" transform="rotate(45 ${px} ${y(current.exactFromUpper)})"/>`;
		drawing += `<g font-size="11" font-weight="700"><line x1="62" y1="17" x2="82" y2="17" stroke="#64113f" stroke-width="4"/><circle cx="72" cy="17" r="4" fill="#64113f"/><text x="88" y="21" fill="#64113f">exact: from lower at 0</text><line x1="62" y1="38" x2="82" y2="38" stroke="#147d79" stroke-width="4"/><rect x="68" y="34" width="8" height="8" fill="#147d79" transform="rotate(45 72 38)"/><text x="88" y="42" fill="#147d79">exact: from upper at 0</text><text x="278" y="21" fill="#bf6d19">– – second order</text><text x="278" y="42" fill="#746a70">··· first order</text><text x="414" y="42" fill="#a36b12">stability</text></g>`;
		const svg = this.querySelector("svg")!;
		svg.innerHTML = drawing;
		for (const key of [
			"epsilon",
			"gap",
			"coupling",
			"slope"
		]) this.querySelector<HTMLOutputElement>(`[data-out=${key}]`)!.textContent = this.get(key).toFixed(2);
		const lowerError = Math.abs(current.secondFromLower - current.exactFromLower), upperError = Math.abs(current.secondFromUpper - current.exactFromUpper), ratio = Math.abs(epsilon) * Math.abs(coupling) / gap;
		const hasDiagonalCrossing = slope !== 0, epsilonStar = hasDiagonalCrossing ? gap / (2 * slope) : null, crossingVisible = epsilonStar !== null && epsilonStar >= -1 && epsilonStar <= 1;
		const epsilonMin = coupling !== 0 ? slope * gap / (2 * (slope * slope + coupling * coupling)) : null;
		const minimumGap = coupling !== 0 ? gap * Math.abs(coupling) / Math.hypot(slope, coupling) : null;
		let crossingNote: string;
		if (coupling === 0 && slope === 0) crossingNote = " Exact zero coupling and zero slope: the diagonal branches remain separated, so there is no crossing.";
		else if (coupling === 0 && crossingVisible) crossingNote = ` Exact zero coupling: the analytic diagonal branches cross at ε*=${epsilonStar!.toFixed(3)} and retain their identities as their numerical order reverses.`;
		else if (coupling === 0) crossingNote = ` Exact zero coupling: the analytic diagonal branches are exact, but their crossing ε*=${epsilonStar!.toFixed(3)} lies outside the plotted interval.`;
		else if (slope === 0) crossingNote = ` Non-zero coupling prevents a real crossing. Because s=0, the uncoupled diagonal branches never cross, so this is not an avoided crossing. The exact gap is minimized at ε_min=${epsilonMin!.toFixed(3)} with value ${minimumGap!.toFixed(3)}.`;
		else if (crossingVisible) crossingNote = ` The uncoupled crossing ε*=${epsilonStar!.toFixed(3)} lies in the plot; non-zero coupling turns it into an avoided crossing with gap ${(2 * Math.abs(coupling * Number(epsilonStar))).toFixed(3)} there. The exact minimum occurs at ε_min=${epsilonMin!.toFixed(3)} and equals ${minimumGap!.toFixed(3)}.`;
		else crossingNote = ` Non-zero coupling prevents a real crossing, but the uncoupled crossing ε*=${epsilonStar!.toFixed(3)} lies outside the plot. The exact gap is minimized at ε_min=${epsilonMin!.toFixed(3)} with value ${minimumGap!.toFixed(3)}.`;
		const summary = `Branch from lower level at ε=0: exact ${current.exactFromLower.toFixed(3)}, second order ${current.secondFromLower.toFixed(3)}, error ${lowerError.toFixed(3)}. Branch from upper level at ε=0: exact ${current.exactFromUpper.toFixed(3)}, second order ${current.secondFromUpper.toFixed(3)}, error ${upperError.toFixed(3)}. Largest branchwise error ${Math.max(lowerError, upperError).toFixed(3)}. Coupling-to-gap ratio |εc|/Δ=${ratio.toFixed(3)}; stability radius |ε|‖V‖=${radius.toFixed(3)}.${crossingNote}`;
		svg.setAttribute("aria-label", summary);
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>Branch from lower level at ε=0: exact ${current.exactFromLower.toFixed(3)}</strong><br>Branch from upper level at ε=0: exact ${current.exactFromUpper.toFixed(3)}.<br>Second order: ${current.secondFromLower.toFixed(3)}, ${current.secondFromUpper.toFixed(3)} · largest branchwise error ${Math.max(lowerError, upperError).toFixed(3)}.<br>Coupling-to-gap ratio |εc|/Δ=${ratio.toFixed(3)}; stability radius |ε|‖V‖=${radius.toFixed(3)}.${crossingNote}`;
	}
}
if (!customElements.get("perturbation-lab")) customElements.define("perturbation-lab", PerturbationLab);