class CourseProgress extends HTMLElement {
	connectedCallback() {
		const lecture = this.dataset.lecture;
		const key = `linalg-progress-${lecture}`;
		let stored: string[] = [];
		try {
			stored = JSON.parse(localStorage.getItem(key) || "[]");
		} catch {
			stored = [];
		}
		const boxes = [...this.querySelectorAll<HTMLInputElement>("input[type=\"checkbox\"]")];
		const count = this.querySelector<HTMLElement>("[data-progress-count]");
		const bar = this.querySelector<HTMLElement>("[data-progress-bar]");
		const update = () => {
			const complete = boxes.filter((item) => item.checked).length;
			if (count) count.textContent = `${complete}/${boxes.length}`;
			if (bar) bar.style.width = `${complete / boxes.length * 100}%`;
		};
		boxes.forEach((box) => {
			box.checked = stored.includes(box.value);
			box.addEventListener("change", () => {
				const selected = boxes.filter((item) => item.checked).map((item) => item.value);
				localStorage.setItem(key, JSON.stringify(selected));
				update();
			});
		});
		update();
	}
}
if (!customElements.get("course-progress")) customElements.define("course-progress", CourseProgress);