class KernelImageLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const a = this.get("a"), b = this.get("b"), c = this.get("c"), d = this.get("d"), x = this.get("x"), y = this.get("y");
		const determinant = a * d - b * c;
		const norm = Math.hypot(a, b, c, d);
		const epsilon = 1e-8 * Math.max(1, norm);
		const rank = norm < epsilon ? 0 : Math.abs(determinant) < epsilon ? 1 : 2;
		const out = {
			x: a * x + b * y,
			y: c * x + d * y
		};
		const left = {
			cx: 155,
			cy: 170
		}, right = {
			cx: 465,
			cy: 170
		}, scale = 48;
		const line = (x1: number, y1: number, x2: number, y2: number, color: string, width = 1, dash = "") => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (const panel of [left, right]) {
			for (let i = -3; i <= 3; i++) drawing += line(panel.cx + i * scale, panel.cy - 145, panel.cx + i * scale, panel.cy + 145, "#ece7e9") + line(panel.cx - 140, panel.cy + i * scale, panel.cx + 140, panel.cy + i * scale, "#ece7e9");
			drawing += line(panel.cx - 145, panel.cy, panel.cx + 145, panel.cy, "#746a70", 1.5) + line(panel.cx, panel.cy - 150, panel.cx, panel.cy + 150, "#746a70", 1.5);
		}
		const arrow = (panel: {
			cx: number;
			cy: number;
		}, vx: number, vy: number, color: string, label: string) => `${line(panel.cx, panel.cy, panel.cx + vx * scale, panel.cy - vy * scale, color, 4)}<circle cx="${panel.cx + vx * scale}" cy="${panel.cy - vy * scale}" r="5" fill="${color}"/><text x="${panel.cx + vx * scale + 7}" y="${panel.cy - vy * scale - 7}" fill="${color}" font-weight="700">${label}</text>`;
		drawing += arrow(left, x, y, "#64113f", "v") + arrow(right, out.x, out.y, "#64113f", "Av");
		if (rank === 1) {
			const k = Math.hypot(a, b) > epsilon ? {
				x: -b,
				y: a
			} : {
				x: -d,
				y: c
			};
			const kn = Math.hypot(k.x, k.y);
			const kx = k.x / kn, ky = k.y / kn;
			drawing += line(left.cx - kx * 135, left.cy + ky * 135, left.cx + kx * 135, left.cy - ky * 135, "#175b68", 4, "7 5");
			const im = Math.hypot(a, c) > epsilon ? {
				x: a,
				y: c
			} : {
				x: b,
				y: d
			};
			const imn = Math.hypot(im.x, im.y);
			const ix = im.x / imn, iy = im.y / imn;
			drawing += line(right.cx - ix * 135, right.cy + iy * 135, right.cx + ix * 135, right.cy - iy * 135, "#bf6d19", 5);
		}
		const svg = this.querySelector("svg")!;
		svg.innerHTML = `<text x="155" y="18" text-anchor="middle" fill="#6c6068" font-weight="700">Sritis V</text><text x="465" y="18" text-anchor="middle" fill="#6c6068" font-weight="700">Vaizdas W</text><path d="M292 160 L326 160" stroke="#64113f" stroke-width="2"/><path d="M326 160 l-9 -6 v12 z" fill="#64113f"/><text x="309" y="148" text-anchor="middle" fill="#64113f" font-weight="700">A</text>${drawing}`;
		let detail = rank === 2 ? "Branduolys yra {0}; vaizdas — visa plokštuma." : rank === 1 ? "Mėlyna punktyrinė tiesė yra branduolys; oranžinė tiesė — vaizdas." : "Nulinis atvaizdis: branduolys yra visa sritis, vaizdas — {0}.";
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>det A = ${determinant.toFixed(2)} · rank A = ${rank} · nullity A = ${2 - rank}</strong><br>Av = (${out.x.toFixed(2)}, ${out.y.toFixed(2)}). ${detail}`;
	}
}
if (!customElements.get("kernel-image-lab")) customElements.define("kernel-image-lab", KernelImageLab);