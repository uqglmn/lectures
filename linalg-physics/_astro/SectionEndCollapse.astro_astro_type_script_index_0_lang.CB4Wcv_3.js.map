document.querySelectorAll<HTMLButtonElement>("[data-collapse-section]").forEach((button) => {
	if (button.dataset.collapseReady === "true") return;
	button.dataset.collapseReady = "true";
	button.addEventListener("click", () => {
		const section = button.closest("details");
		const heading = section?.querySelector<HTMLElement>(":scope > summary");
		if (!(section instanceof HTMLDetailsElement) || !heading) return;
		section.open = false;
		heading.focus({ preventScroll: true });
		heading.scrollIntoView({
			behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
			block: "start"
		});
	});
});