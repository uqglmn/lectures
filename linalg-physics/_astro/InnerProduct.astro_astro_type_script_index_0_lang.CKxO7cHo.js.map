class InnerProductLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	format(value: number) {
		if (Math.abs(value) < 5e-10) return "0";
		return Number(value.toPrecision(5)).toString();
	}
	complex(re: number, im: number) {
		const r = Math.abs(re) < 5e-10 ? 0 : re, m = Math.abs(im) < 5e-10 ? 0 : im;
		if (m === 0) return this.format(r);
		if (r === 0) return `${m < 0 ? "−" : ""}${Math.abs(m) === 1 ? "" : this.format(Math.abs(m))}i`;
		return `${this.format(r)} ${m < 0 ? "−" : "+"} ${Math.abs(m) === 1 ? "" : this.format(Math.abs(m))}i`;
	}
	draw() {
		const ru = this.get("ru"), rv = this.get("rv"), angle = this.get("angle"), phase = this.get("phase"), theta = angle * Math.PI / 180, phi = phase * Math.PI / 180, u = {
			x: ru,
			y: 0
		}, v = {
			x: rv * Math.cos(theta),
			y: rv * Math.sin(theta)
		}, sum = {
			x: u.x + v.x,
			y: v.y
		}, projection = {
			x: rv * Math.cos(theta),
			y: 0
		};
		const inner = ru * rv * Math.cos(theta), sumNorm = Math.hypot(sum.x, sum.y), probability = Math.cos(theta) ** 2, cx = 220, cy = 245;
		const maxX = Math.max(ru, Math.abs(v.x), Math.abs(sum.x), .5), maxY = Math.max(Math.abs(v.y), Math.abs(sum.y), .5), scale = Math.min(145 / maxX, 185 / maxY);
		const pt = (q: {
			x: number;
			y: number;
		}) => ({
			x: cx + q.x * scale,
			y: cy - q.y * scale
		}), line = (a: {
			x: number;
			y: number;
		}, b: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		const arrow = (q: {
			x: number;
			y: number;
		}, color: string, label: string) => {
			const e = pt(q);
			return `${line({
				x: cx,
				y: cy
			}, e, color, 5)}<circle cx="${e.x}" cy="${e.y}" r="5" fill="${color}"/><text x="${e.x + 8}" y="${e.y - 8}" fill="${color}" font-weight="700">${label}</text>`;
		};
		let drawing = "";
		for (let i = -4; i <= 4; i++) drawing += line({
			x: cx + i * 38,
			y: 25
		}, {
			x: cx + i * 38,
			y: 315
		}, "#ece7e9");
		for (let i = -2; i <= 5; i++) drawing += line({
			x: 55,
			y: cy - i * 38
		}, {
			x: 385,
			y: cy - i * 38
		}, "#ece7e9");
		drawing += line({
			x: 55,
			y: cy
		}, {
			x: 385,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 315
		}, {
			x: cx,
			y: 25
		}, "#746a70") + arrow(u, "#8f164d", "u") + arrow(v, "#147d79", "v") + arrow(sum, "#945508", "u+v");
		drawing += line(pt(projection), pt(v), "#147d79", 3, "6 4") + line({
			x: cx,
			y: cy
		}, pt(projection), "#23724a", 5, "7 4");
		drawing += `<path d="M ${cx + 35} ${cy} A 35 35 0 0 0 ${cx + 35 * Math.cos(theta)} ${cy - 35 * Math.sin(theta)}" fill="none" stroke="#626b7c" stroke-width="2"/><text x="${cx + 43 * Math.cos(theta / 2)}" y="${cy - 43 * Math.sin(theta / 2)}" fill="#626b7c">θ</text>`;
		const svg = this.querySelector("svg")!;
		svg.innerHTML = drawing;
		this.querySelector<HTMLOutputElement>("[data-out=ru]")!.textContent = ru.toFixed(2);
		this.querySelector<HTMLOutputElement>("[data-out=rv]")!.textContent = rv.toFixed(2);
		this.querySelector<HTMLOutputElement>("[data-out=angle]")!.textContent = `${angle}°`;
		this.querySelector<HTMLOutputElement>("[data-out=phase]")!.textContent = `${phase}°`;
		const realCsEquality = angle === 0 || angle === 180, triangleEquality = angle === 0;
		const complexInner = {
			re: ru * rv * Math.cos(phi),
			im: ru * rv * Math.sin(phi)
		}, complexSum = Math.hypot(ru + rv * Math.cos(phi), rv * Math.sin(phi)), complexTriangle = phase === 0 || phase === 360;
		const summary = `<strong>ℝ² slice:</strong> ⟨u,v⟩=${this.format(inner)} and |⟨û,v̂⟩|²=${this.format(probability)}.<br>Cauchy–Schwarz: |${this.format(inner)}| ≤ ${this.format(ru * rv)} (${realCsEquality ? "equality: real collinearity" : "strict"}). Triangle: ‖u+v‖=${this.format(sumNorm)} ≤ ${this.format(ru + rv)} (${triangleEquality ? "equality: nonnegative real collinearity" : "strict"}).<br><strong>ℂ² companion:</strong> u=(${this.format(ru)},0), v=(${this.complex(rv * Math.cos(phi), rv * Math.sin(phi))},0), so ⟨u,v⟩=${this.complex(complexInner.re, complexInner.im)}, normalized transition probability = 1, and Cauchy–Schwarz is equality because the vectors are complex-collinear. Triangle: ‖u+v‖=${this.format(complexSum)} ≤ ${this.format(ru + rv)} (${complexTriangle ? "equality: same phase" : "strict: the phase is not a nonnegative real multiple"}).`;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = summary;
		svg.setAttribute("aria-label", `Real R2 slice: inner product ${this.format(inner)}, normalized overlap probability ${this.format(probability)}; Cauchy–Schwarz ${realCsEquality ? "equality" : "strict"}; triangle inequality ${triangleEquality ? "equality" : "strict"}. Complex C2 companion at phase ${phase} degrees: inner product ${this.complex(complexInner.re, complexInner.im)}, transition probability 1, Cauchy–Schwarz equality by complex collinearity, triangle inequality ${complexTriangle ? "equality" : "strict"}.`);
	}
}
if (!customElements.get("inner-product-lab")) customElements.define("inner-product-lab", InnerProductLab);