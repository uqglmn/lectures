class DualSpaceLab extends HTMLElement {
	connectedCallback() {
		this.querySelectorAll("input,select").forEach((input) => input.addEventListener("input", () => this.draw()));
		this.draw();
	}
	get(key: string) {
		return Number(this.querySelector<HTMLInputElement>(`[data-key=${key}]`)?.value || 0);
	}
	draw() {
		const a = this.get("a"), b = this.get("b"), v = {
			x: this.get("x"),
			y: this.get("y")
		}, kind = this.querySelector<HTMLSelectElement>("[data-map]")?.value || "shear";
		const maps: Record<string, number[][]> = {
			shear: [[1, 1], [0, 1]],
			scale: [[2, 0], [0, .5]],
			rotate: [[0, -1], [1, 0]]
		}, A = maps[kind], Tv = {
			x: A[0][0] * v.x + A[0][1] * v.y,
			y: A[1][0] * v.x + A[1][1] * v.y
		}, pull = {
			x: A[0][0] * a + A[1][0] * b,
			y: A[0][1] * a + A[1][1] * b
		};
		const evaluation = a * v.x + b * v.y, after = a * Tv.x + b * Tv.y, cx = 220, cy = 170, s = 64, pt = (q: {
			x: number;
			y: number;
		}) => ({
			x: cx + q.x * s,
			y: cy - q.y * s
		});
		const line = (p: {
			x: number;
			y: number;
		}, q: {
			x: number;
			y: number;
		}, color: string, width = 2, dash = "") => `<line x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" stroke="${color}" stroke-width="${width}" ${dash ? `stroke-dasharray="${dash}"` : ""}/>`;
		let drawing = "";
		for (let i = -4; i <= 4; i++) {
			drawing += line({
				x: cx + i * 38,
				y: 25
			}, {
				x: cx + i * 38,
				y: 315
			}, "#ece7e9") + line({
				x: 65,
				y: cy + i * 38
			}, {
				x: 375,
				y: cy + i * 38
			}, "#ece7e9");
		}
		drawing += line({
			x: 60,
			y: cy
		}, {
			x: 380,
			y: cy
		}, "#746a70") + line({
			x: cx,
			y: 320
		}, {
			x: cx,
			y: 20
		}, "#746a70");
		const norm = Math.hypot(a, b);
		if (norm > 1e-8) {
			const tangent = {
				x: -b / norm,
				y: a / norm
			}, normal = {
				x: a / norm,
				y: b / norm
			};
			for (let k = -2; k <= 2; k++) {
				const center = {
					x: normal.x * k * .75,
					y: normal.y * k * .75
				};
				drawing += line(pt({
					x: center.x - 2.6 * tangent.x,
					y: center.y - 2.6 * tangent.y
				}), pt({
					x: center.x + 2.6 * tangent.x,
					y: center.y + 2.6 * tangent.y
				}), "#147d79", k === 0 ? 4 : 2, k === 0 ? "" : "6 5");
			}
			drawing += line({
				x: cx,
				y: cy
			}, pt({
				x: normal.x * 1.4,
				y: normal.y * 1.4
			}), "#8f164d", 5);
		}
		const end = pt(v), mapped = pt(Tv);
		drawing += line({
			x: cx,
			y: cy
		}, end, "#945508", 5) + `<circle cx="${end.x}" cy="${end.y}" r="5" fill="#945508"/><text x="${end.x + 7}" y="${end.y - 7}" fill="#945508" font-weight="700">v</text>` + line({
			x: cx,
			y: cy
		}, mapped, "#23724a", 4, "7 4") + `<text x="${mapped.x + 7}" y="${mapped.y - 7}" fill="#23724a" font-weight="700">Tv</text>`;
		this.querySelector("svg")!.innerHTML = drawing;
		this.querySelector<HTMLElement>("[data-summary]")!.innerHTML = `<strong>φ(v) = ${evaluation.toFixed(3)} · φ(Tv) = ${after.toFixed(3)}</strong><br>The pullback T′φ has coordinates Aᵀφ = (${pull.x.toFixed(3)}, ${pull.y.toFixed(3)}), and (T′φ)(v)=φ(Tv). Under Riesz, (a,b) is the normal to every level line.`;
	}
}
if (!customElements.get("dual-space-lab")) customElements.define("dual-space-lab", DualSpaceLab);